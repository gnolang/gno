-- input.md --

<gno-form exec="Transfer&quot; $(echo injected) &quot;">
  <gno-input name="to" />
</gno-form>

<gno-form exec="transfer">
  <gno-input name="to" />
</gno-form>

<gno-form exec="">
  <gno-input name="to" />
</gno-form>

-- output.html --
<!-- Error: &#34;Transfer\&#34; $(echo injected) \&#34;&#34;: &#39;exec&#39; attribute is not an exported function name -->
