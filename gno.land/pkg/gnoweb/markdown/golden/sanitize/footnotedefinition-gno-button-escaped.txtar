// MARKDOWNFUNC: FootnoteDefinition
// ARGS: "n1"
// CONTEXT: text[^n1]\n\n%s
-- input.md --
<gno-button href="https://evil.example" label="Claim" />
-- output.md --
[^n1]:
    \<gno-button href="https://evil.example" label="Claim" />
-- output.html --
<p>text<sup id="fnref:1"><a href="#fn:1" class="footnote-ref" role="doc-noteref">1</a></sup></p>
<div class="footnotes" role="doc-endnotes">
<hr>
<ol>
<li id="fn:1">
<p>&lt;gno-button href=&quot;https://evil.example&quot; label=&quot;Claim&quot; /&gt;&#160;<a href="#fnref:1" class="footnote-backref" role="doc-backlink">&#x21a9;&#xfe0e;</a></p>
</li>
</ol>
</div>
