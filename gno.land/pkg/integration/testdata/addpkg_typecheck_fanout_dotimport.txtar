# Value-containment fan-out routed across an import boundary via a DOT import.
# The cost model resolves an unqualified type name in the declaring package only,
# so a dot-imported type scores as a leaf and its expansion goes unpriced — the
# same containment shape that addpkg_typecheck_fanout_imported charges for as
# `p0.T` is walked for free when written as a bare `T`. Gno does not support dot
# imports, but the preprocessor's rejection runs AFTER the type checker on this
# path, so go/types would already have spent the unmetered validType CPU.
# checkNoDotImports must reject the deploy before that.
#
# The rejection is purely syntactic, so it does not depend on p0 being deployed.
# p0 is here so the shape is the real vector rather than a bare syntax check.
#
# What this fixture does NOT show: measured against master, it does not hang — the
# preprocessor rejects it in about a second, after go/types has walked ~6M nodes
# (~200ms). So the difference this guard makes here is WHEN the rejection happens
# and how much unmetered CPU is spent first, not hang versus no-hang. Sizing it to
# actually wedge a node would need a chain deep enough that the archive took
# minutes on master and told us nothing extra. For a verified wedge see
# addpkg_typecheck_fanout.txtar.

# start a new node
gnoland start

# p0: a doubling chain that pays for its own expansion and deploys
gnokey maketx addpkg -pkgdir $WORK/p0 -pkgpath gno.land/r/foobar/p0 -gas-fee 350001ugnot -gas-wanted 20_000_000 -chainid=tendermint_test $test1_user_addr

# fan: continues the chain over p0's T, reached through a dot import, so its true
# cross-package expansion goes unpriced. It must be rejected before go/types.
! gnokey maketx addpkg -pkgdir $WORK/fan -pkgpath gno.land/r/foobar/fan -gas-fee 350001ugnot -gas-wanted 20_000_000 -chainid=tendermint_test $test1_user_addr
stderr 'dot imports are not allowed in Gno'

-- p0/gnomod.toml --
module = "gno.land/r/foobar/p0"
gno = "0.9"

-- p0/p0.gno --
package p0

type t0 struct{ v int }
type t1 struct{ a, b [0]t0 }
type t2 struct{ a, b [0]t1 }
type t3 struct{ a, b [0]t2 }
type t4 struct{ a, b [0]t3 }
type t5 struct{ a, b [0]t4 }
type t6 struct{ a, b [0]t5 }
type t7 struct{ a, b [0]t6 }
type t8 struct{ a, b [0]t7 }
type t9 struct{ a, b [0]t8 }
type T struct{ a, b [0]t9 }

-- fan/gnomod.toml --
module = "gno.land/r/foobar/fan"
gno = "0.9"

-- fan/fan.gno --
package fan

import . "gno.land/r/foobar/p0"

type u0 struct{ a, b [0]T }
type u1 struct{ a, b [0]u0 }
type u2 struct{ a, b [0]u1 }
type u3 struct{ a, b [0]u2 }
type u4 struct{ a, b [0]u3 }
type u5 struct{ a, b [0]u4 }
type u6 struct{ a, b [0]u5 }
type u7 struct{ a, b [0]u6 }
type u8 struct{ a, b [0]u7 }
type u9 struct{ a, b [0]u8 }
