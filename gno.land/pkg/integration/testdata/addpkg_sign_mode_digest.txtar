gnoland start

# A PACKAGE TOO LARGE FOR A LEDGER STILL DEPLOYS. The device parses the
# signature payload itself, so a file body past its buffer cannot be signed in
# full mode at all. In digest mode the body reaches the device as a hash, and
# the chain has to accept that rendering -- including on the simulation path,
# which signs the tx a second time with the gas raised.
gnokey maketx addpkg -pkgdir $WORK/big -pkgpath gno.land/r/foobar/big -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test -sign-mode digest test1
stdout 'OK!'

# And the signer is told what the device will not show them.
stdout 'sign mode digest'
stdout 'package\.files\[\d+\]\.body'
stdout '[0-9]+ bytes'

# A misspelled mode is refused rather than signed in full mode, which is the
# failure the flag exists to avoid.
! gnokey maketx addpkg -pkgdir $WORK/small -pkgpath gno.land/r/foobar/small -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test -sign-mode hash test1
stderr 'invalid sign mode "hash"'

# Digest mode hides nothing in a package that fits, and says so.
gnokey maketx addpkg -pkgdir $WORK/small -pkgpath gno.land/r/foobar/small -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test -sign-mode digest test1
stdout 'nothing to digest'
stdout 'OK!'

# Full mode remains the default.
gnokey maketx addpkg -pkgdir $WORK/plain -pkgpath gno.land/r/foobar/plain -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stdout 'OK!'
! stdout 'sign mode digest'

