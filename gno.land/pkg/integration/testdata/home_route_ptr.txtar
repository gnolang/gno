# Route: *cbvictim.P, a dereferenced pointer to a struct nesting a function value.
# Same verdict cold, after a read that loads the nested value, and after a restart.

loadpkg gno.land/r/tests/vm/cbother
gnoland start
! gnokey maketx call -pkgpath gno.land/r/tests/vm/cbother -func Ptr -args false -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/tests/vm/cbvictim''s code is read-only here: a function value writes only as a literal called where it is written, or passed in place to a plain function of this realm or a /p/ function called by name, while that call runs'
! gnokey maketx call -pkgpath gno.land/r/tests/vm/cbother -func Ptr -args true -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/tests/vm/cbvictim''s code is read-only here: a function value writes only as a literal called where it is written, or passed in place to a plain function of this realm or a /p/ function called by name, while that call runs'

gnoland restart

! gnokey maketx call -pkgpath gno.land/r/tests/vm/cbother -func Ptr -args false -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/tests/vm/cbvictim''s code is read-only here: a function value writes only as a literal called where it is written, or passed in place to a plain function of this realm or a /p/ function called by name, while that call runs'

gnoland restart

! gnokey maketx call -pkgpath gno.land/r/tests/vm/cbother -func Ptr -args true -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/tests/vm/cbvictim''s code is read-only here: a function value writes only as a literal called where it is written, or passed in place to a plain function of this realm or a /p/ function called by name, while that call runs'
gnokey query vm/qeval --data 'gno.land/r/tests/vm/cbvictim.Owner'
stdout 'victim'
