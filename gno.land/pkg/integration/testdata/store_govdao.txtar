func main(cur realm) {
	dao.MustCreateProposal(cross(cur), store.ProposeSuccessor(cross(cur), "gno.land/r/gnoland/store/v1"))
}

-- myapp/gnomod.toml --
module = "gno.land/r/acme/myapp"
gno = "0.9"

-- myapp/myapp.gno --
package myapp

import store "gno.land/r/gnoland/store/v0"

func init(cur realm) {
	store.Register(cross(cur), "acme-app", "Acme App", "A tagline", "utilities", 0)
}

func Render(string) string { return "Acme" }
