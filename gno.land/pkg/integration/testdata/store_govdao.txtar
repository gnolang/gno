import (
	"gno.land/r/gov/dao"
	store "gno.land/r/gnoland/store/v0"
)

func main(cur realm) {
	dao.MustCreateProposal(cross(cur), store.ProposeUnhide(cross(cur), "gno.land/r/gnoland/blog"))
}

-- run/propose_pause.gno --
