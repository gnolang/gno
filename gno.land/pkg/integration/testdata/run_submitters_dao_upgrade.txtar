# ProposeSetRunSubmitters asks the current GovDAO implementation who its
# members are. After an upgrade to an implementation that keeps its own
# members, a member of the new DAO can still replace vm:p:run_submitters, and a
# member of the old one no longer can.

loadpkg gno.land/r/gov/dao
loadpkg gno.land/r/gov/dao/impl/v0
loadpkg gno.land/r/sys/params
loadpkg gno.land/r/gov/dao/loader/v0 $WORK/loader

adduser alice

gnoland start

# A new DAO implementation with its own member list.
gnokey maketx addpkg -pkgdir $WORK/daov1 -pkgpath gno.land/r/test/daov1 -gas-fee 10000000ugnot -gas-wanted 50_000_000 -chainid=tendermint_test test1
stdout OK!

# test1, the only memberstore/v0 member, passes the upgrade through impl/v0.
gnokey maketx run -gas-fee 10000000ugnot -gas-wanted 90_000_000 -chainid=tendermint_test test1 $WORK/run/upgrade.gno
stdout 'executed: true'
gnokey query vm/qeval --data 'gno.land/r/gov/dao.AllowedDAOs()'
stdout 'gno.land/r/test/daov1'

# alice joins the new DAO, which is now GovDAO.
gnokey maketx call -pkgpath gno.land/r/test/daov1 -func Join -gas-fee 5000000ugnot -gas-wanted 40_000_000 -chainid=tendermint_test alice
stdout OK!

# Control: alice can govern. Her params proposal is created and executes.
gnokey maketx run -gas-fee 10000000ugnot -gas-wanted 90_000_000 -chainid=tendermint_test alice $WORK/run/alice_param.gno
stdout 'executed: true'
gnokey query params/bank:p:restricted_denoms
stdout 'byalice'

# test1 is still in memberstore/v0 but not in the new DAO: refused at build.
! gnokey maketx run -gas-fee 10000000ugnot -gas-wanted 90_000_000 -chainid=tendermint_test test1 $WORK/run/test1_submitters.gno
stderr 'the builder is not a GovDAO member'

# alice, a member of the new DAO only, replaces the list.
gnokey maketx run -gas-fee 10000000ugnot -gas-wanted 90_000_000 -chainid=tendermint_test alice $WORK/run/alice_submitters.gno
stdout 'executed: true'
gnokey query params/vm:p:run_submitters
stdout $alice_user_addr

-- daov1/gnomod.toml --
module = "gno.land/r/test/daov1"
gno = "0.9"
-- daov1/daov1.gno --
package daov1

import (
	"chain/runtime/unsafe"
	"errors"

	"gno.land/r/gov/dao"
)

// DAO is a minimal GovDAO implementation: members join themselves, votes are
// ignored and every proposal passes.
type DAO struct{}

var (
	members = map[address]bool{}
	inst    = &DAO{}
)

func Instance() *DAO { return inst }

func Join(cur realm) { members[cur.Previous().Address()] = true }

func (d *DAO) PreCreateProposal(_ int, rlm realm, r dao.ProposalRequest) (address, error) {
	caller := unsafe.OriginCaller()
	if !members[caller] {
		return caller, errors.New("daov1: only members can create proposals")
	}
	return caller, nil
}

func (d *DAO) PostCreateProposal(_ int, rlm realm, r dao.ProposalRequest, pid dao.ProposalID) {}

func (d *DAO) VoteOnProposal(_ int, rlm realm, r dao.VoteRequest) error { return nil }

func (d *DAO) PreExecuteProposal(_ int, rlm realm, pid dao.ProposalID) (bool, error) {
	return true, nil
}

func (d *DAO) ExecuteProposal(_ int, rlm realm, pid dao.ProposalID, e dao.Executor) error {
	return e.Execute(cross(rlm))
}

func (d *DAO) IsMember(addr address) bool { return members[addr] }

func (d *DAO) Render(cur realm, pkgpath string, path string) string { return "daov1" }

-- run/upgrade.gno --
package main

import (
	"gno.land/r/gov/dao"
	impl "gno.land/r/gov/dao/impl/v0"
	"gno.land/r/test/daov1"
)

func main(cur realm) {
	pr := impl.NewUpgradeDaoImplRequest(cross(cur), daov1.Instance(), "gno.land/r/test/daov1", "move to daov1")
	pid := dao.MustCreateProposal(cross(cur), pr)
	dao.MustVoteOnProposal(cross(cur), dao.NewVoteRequest(dao.YesVote, pid))
	println("executed:", dao.ExecuteProposal(cross(cur), pid))
}

-- run/alice_param.gno --
package main

import (
	"gno.land/r/gov/dao"
	params "gno.land/r/sys/params"
)

func main(cur realm) {
	pr := params.NewSysParamStringsPropRequest(cross(cur), "bank", "p", "restricted_denoms", []string{"byalice"})
	pid := dao.MustCreateProposal(cross(cur), pr)
	println("executed:", dao.ExecuteProposal(cross(cur), pid))
}

-- run/alice_submitters.gno --
package main

import (
	"gno.land/r/gov/dao"
	params "gno.land/r/sys/params"
)

func main(cur realm) {
	pr := params.ProposeSetRunSubmitters(cross(cur), []string{cur.Address().String()})
	pid := dao.MustCreateProposal(cross(cur), pr)
	println("executed:", dao.ExecuteProposal(cross(cur), pid))
}

-- run/test1_submitters.gno --
package main

import (
	"gno.land/r/gov/dao"
	params "gno.land/r/sys/params"
)

func main(cur realm) {
	pr := params.ProposeSetRunSubmitters(cross(cur), []string{cur.Address().String()})
	dao.MustCreateProposal(cross(cur), pr)
}

-- loader/load_govdao.gno --
package loader

import (
	"gno.land/r/gov/dao"
	"gno.land/r/gov/dao/impl/v0"
	"gno.land/r/gov/dao/memberstore/v0"
)

func init(cur realm) {
	memberstore.Get(0, cur).SetTier(memberstore.T1)
	memberstore.Get(0, cur).SetTier(memberstore.T2)
	memberstore.Get(0, cur).SetTier(memberstore.T3)
	memberstore.Get(0, cur).SetMember(memberstore.T1, address("g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"), memberstore.NewMember(3))
	dao.UpdateImpl(cross(cur), dao.NewUpdateRequest(impl.GetInstance(0, cur), []string{"gno.land/r/gov/dao/impl/v0"}))
}
