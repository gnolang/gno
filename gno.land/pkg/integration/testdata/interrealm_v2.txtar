## ============================================================
## Round-trip of a stored object
## ============================================================

## READONLY_RoundTripSucceeds: caller passes owned.GlobalSlice back through
## owned.MutateSlice without crossing: refused.
##
##   func READONLY_RoundTripSucceeds(cur realm) {
##       owned.MutateSlice(owned.GlobalSlice)
##   }
! gnokey maketx call -pkgpath gno.land/r/test/caller -func READONLY_RoundTripSucceeds -gas-fee 1000000ugnot -gas-wanted 10000000 -chainid=tendermint_test test1
stderr 'gno.land/r/test/owned.s code was entered without crossing and is read-only'


## ============================================================
## Realm-context invariant
## ============================================================

## CTX_BorrowDoesNotShiftCurrentRealm: the non-crossing body's write to owned.trace is refused.
##
##   func CTX_BorrowDoesNotShiftCurrentRealm(cur realm) {
##       owned.Real.RecordRealmTraceForCTX()
##   }
! gnokey maketx call -pkgpath gno.land/r/test/caller -func CTX_BorrowDoesNotShiftCurrentRealm -gas-fee 800001ugnot -gas-wanted 8_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/test/owned.s code was entered without crossing and is read-only'


## ============================================================
## Defer/recover
## ============================================================

## DEFER_BorrowUnwindAfterRecover: a non-crossing /r/owned function panics.
## In Gno, cross-realm panics are NOT caught by ordinary recover()
## from a foreign realm — the runtime escalates them past defer/
## recover boundaries to enforce realm-boundary safety. The
## equivalent capability is `revive(fn)` (see panic-revive spec).
## This case demonstrates that an unrecovered cross-realm panic
## leaks through caller's defer/recover and aborts the tx.
##
##   func DEFER_BorrowUnwindAfterRecover(cur realm) {
##       defer func() {
##           if recover() != nil {
##               owned.RecordDeferResume()
##           }
##       }()
##       owned.PanicInsideBorrow()
##   }
! gnokey maketx call -pkgpath gno.land/r/test/caller -func DEFER_BorrowUnwindAfterRecover -gas-fee 800001ugnot -gas-wanted 8_000_000 -chainid=tendermint_test test1
stderr 'intentional panic for unwind test'


## ============================================================
## Copy semantics
## ============================================================

## COPY_PreservesPkgID: value-method dispatch copies the receiver; the copy keeps
## its source realm. The trace is recorded through a crossing call.
##
##   func COPY_PreservesPkgID(cur realm) {
##       r := owned.Factory()
##       // value-method dispatch — Copy preserves PkgID:
##       id := (*r).Identify()
##       owned.RecordCopyTrace(cross(cur), id)
##   }
gnokey maketx call -pkgpath gno.land/r/test/caller -func COPY_PreservesPkgID -gas-fee 800001ugnot -gas-wanted 8_000_000 -chainid=tendermint_test test1
stdout OK!
gnokey query "vm/qrender" --data "gno.land/r/test/owned:"
stdout 'trace=COPY:gno.land/r/test/owned'

## COPY_PInitRestampedToCurRealm: a /p/ helper (CopyAndMutate) copies
## its /p/-init-allocated default into a local and writes through that
## local — the same pattern as gno.land/p/jeronimoalbi/datasource.NewQuery.
## Without the IsRealmPkg gate in Copy the local would inherit /p/'s
## PkgID and the write would trip the readonly check (m.Realm = caller
## ≠ /p/); with the gate, the copy is restamped to currentRealmID and
## the mutation succeeds.
##
##   func COPY_PInitRestampedToCurRealm(cur realm) {
##       n := v2lib.CopyAndMutate(42)
##       if n != 42 {
##           panic("write did not take effect")
##       }
##       owned.RecordCopyTrace(cross(cur), "PInitRestamped")
##   }
gnokey maketx call -pkgpath gno.land/r/test/caller -func COPY_PInitRestampedToCurRealm -gas-fee 800001ugnot -gas-wanted 8_000_000 -chainid=tendermint_test test1
stdout OK!
gnokey query "vm/qrender" --data "gno.land/r/test/owned:"
stdout 'trace=COPY:PInitRestamped'


## ============================================================
## Fixture realms
## ============================================================

-- lib/gnomod.toml --
module = "gno.land/p/test/v2lib"
gno = "0.9"

-- lib/lib.gno --
package v2lib

type LibContainer struct {
	A int
}

func (lc *LibContainer) TouchA() {
	lc.A++
}

// DefaultLib is allocated at /p/ init time; its StructValue carries
// PkgID = /p/test/v2lib (non-realm). CopyAndMutate exercises the same
// pattern as gno.land/p/jeronimoalbi/datasource.NewQuery: a /p/ helper
// copies the default and mutates the local. Without the IsRealmPkg
// gate in Copy, the local would carry /p/ PkgID and the write would
// trip the readonly check (m.Realm = caller's realm ≠ /p/).
var DefaultLib = LibContainer{A: 7}

func CopyAndMutate(newA int) int {
	c := DefaultLib
	c.A = newA
	return c.A
}

type PrimitiveCounter int

func (pc PrimitiveCounter) Touch() PrimitiveCounter {
	return pc + 1
}

type Toucher interface {
	Touch()
}


-- owned/gnomod.toml --
module = "gno.land/r/test/owned"
gno = "0.9"

-- owned/owned.gno --
package owned

import (
	"chain/runtime/unsafe"
	"gno.land/p/nt/ufmt/v0"
	"gno.land/p/test/v2lib"
)

type Resource struct {
	Value int
}

func (r *Resource) Mutate() {
	r.Value++
}

func (r Resource) Identify() string {
	return "gno.land/r/test/owned"
}

func (r *Resource) RecordRealmTraceForCTX() {
	trace = "CTX:cur=" + unsafe.CurrentRealm().PkgPath()
}

var (
	global      int
	Real        = &Resource{Value: 0}
	Lib         = &v2lib.LibContainer{A: 0}
	GlobalSlice = []int{1, 2, 3}
	trace       string
)

func MutateGlobal(n int) {
	global = n
}

func OverwriteA(lc *v2lib.LibContainer) {
	lc.A = 99
}

func Factory() *Resource {
	return &Resource{Value: 0}
}

func LibFactory() *v2lib.LibContainer {
	return &v2lib.LibContainer{A: 0}
}

// TouchLib is written in this realm's source and handed over as a value, so
// the write acts for /r/owned without a grant on the receiver.
var TouchLib = func() { Lib.TouchA() }

// TouchFactory does the same for a fresh, unreal container.
var TouchFactory = func() { LibFactory().TouchA() }

var Closure = func() {
	global++
}

func PublicSet(cur realm, n int) {
	global = n
	trace = "L1_CrossingExplicit:cur=" + unsafe.CurrentRealm().PkgPath() +
		",prev=" + unsafe.PreviousRealm().PkgPath()
}

// RecordValueReceiverTrace is invoked from L1_ValueReceiver without
// crossing, so its write is refused.
func RecordValueReceiverTrace() {
	trace = "L1_ValueReceiver:cur=" + unsafe.CurrentRealm().PkgPath()
}

// MutateSlice — readonly round-trip target.
func MutateSlice(s []int) {
	s[0] = 0xff
}

type EvilToucher struct{}

func (e *EvilToucher) Touch() {
	global++
}

// NewEvilToucher returns an unreal EvilToucher; used by
// IFACE_DispatchTargetsDeclaring to put an /r/owned-declared type
// behind a /p/-declared interface in caller's scope. PkgID=/r/owned.
func NewEvilToucher() *EvilToucher {
	return &EvilToucher{}
}

// PanicInsideBorrow is invoked by DEFER_BorrowUnwindAfterRecover.
// Panics inside the non-crossing body; caller's recover cannot catch it.
func PanicInsideBorrow() {
	panic("intentional panic for unwind test")
}

// RecordDeferResume would run after caller's recover; it is never
// reached because the panic is not recoverable across realms.
func RecordDeferResume() {
	trace = "DEFER:recovered-and-resumed"
}

// RecordCopyTrace — crossing writer for the COPY cases. Called from caller
// with the observed declaring realm; the body
// records its observed declaring realm.
func RecordCopyTrace(cur realm, observed string) {
	trace = "COPY:" + observed
}

func Render(_ string) string {
	return ufmt.Sprintf(
		"global=%d realValue=%d libA=%d slice0=%d trace=%s",
		global, Real.Value, Lib.A, GlobalSlice[0], trace)
}


-- neighbor/gnomod.toml --
module = "gno.land/r/test/neighbor"
gno = "0.9"

-- neighbor/neighbor.gno --
package neighbor

import (
	"gno.land/p/nt/ufmt/v0"
	"gno.land/p/test/v2lib"
	"gno.land/r/test/owned"
)

var Lib = &v2lib.LibContainer{A: 0}

// TouchLib is neighbor's own literal, so the write acts for /r/neighbor.
var TouchLib = func() { Lib.TouchA() }

func MutateOwnedVia(r *owned.Resource) {
	r.Mutate()
}

func Render(_ string) string {
	return ufmt.Sprintf("neighborLibA=%d", Lib.A)
}


-- caller/gnomod.toml --
module = "gno.land/r/test/caller"
gno = "0.9"

-- caller/caller.gno --
package caller

import (
	"gno.land/p/test/v2lib"
	"gno.land/r/test/neighbor"
	"gno.land/r/test/owned"
)

// ----- with and without crossing -----

func L1_FnTopLevel(cur realm) {
	owned.MutateGlobal(5)
}

func L1_MethodRealSelf(cur realm) {
	owned.Real.Mutate()
}

func L1_MethodRealForeignWrite(cur realm) {
	owned.OverwriteA(neighbor.Lib)
}

func L1_MethodUnrealSelf(cur realm) {
	r := owned.Factory()
	r.Mutate()
}

func L1_Closure(cur realm) {
	owned.Closure()
}

func L1_BoundMethod(cur realm) {
	f := owned.Real.Mutate
	f()
}

func L1_ValueReceiver(cur realm) {
	owned.RecordValueReceiverTrace()
}

func L1_MultiHop(cur realm) {
	neighbor.MutateOwnedVia(owned.Real)
}

func L1_CrossingExplicit(cur realm) {
	owned.PublicSet(cross(cur), 99)
}

// ----- /p/ methods through an owner's literal -----

func L2_PMethodOnOwnedReal(cur realm) {
	owned.TouchLib()
}

func L2_PMethodOnOwnedUnreal(cur realm) {
	owned.TouchFactory()
}

func L2_PMethodOnNeighborReceiver(cur realm) {
	neighbor.TouchLib()
}

func L2_PMethodOnPrimitiveReceiver(cur realm) {
	var p v2lib.PrimitiveCounter = 42
	_ = p.Touch()
}

// ----- Interface dispatch -----

func IFACE_DispatchTargetsDeclaring(cur realm) {
	var t v2lib.Toucher = owned.NewEvilToucher()
	t.Touch()
}

// ----- Construction-time -----

func CONSTRUCT_CompositeLitFails(cur realm) {
	_ = &owned.Resource{Value: 1}
}

func CONSTRUCT_NewFails(cur realm) {
	_ = new(owned.Resource)
}

// ----- Round-trip of a stored object -----

func READONLY_RoundTripSucceeds(cur realm) {
	owned.MutateSlice(owned.GlobalSlice)
}

// ----- Realm-context invariant -----

func CTX_BorrowDoesNotShiftCurrentRealm(cur realm) {
	owned.Real.RecordRealmTraceForCTX()
}

// ----- Defer/recover -----

func DEFER_BorrowUnwindAfterRecover(cur realm) {
	defer func() {
		if recover() != nil {
			owned.RecordDeferResume()
		}
	}()
	owned.PanicInsideBorrow()
}

// ----- Copy semantics -----

func COPY_PreservesPkgID(cur realm) {
	r := owned.Factory()
	// value-method dispatch — Copy preserves PkgID:
	id := (*r).Identify()
	owned.RecordCopyTrace(cross(cur), id)
}

func COPY_PInitRestampedToCurRealm(cur realm) {
	n := v2lib.CopyAndMutate(42)
	if n != 42 {
		panic("write did not take effect")
	}
	owned.RecordCopyTrace(cross(cur), "PInitRestamped")
}


-- fail_nocross/gnomod.toml --
module = "gno.land/r/test/fail_nocross"
gno = "0.9"

-- fail_nocross/main.gno --
// INTENTIONALLY broken — addpkg must fail at preprocess with
// "cannot cur-call to external realm function ...". Demonstrates
// that the non-crossing-of-crossing-fn pattern is rejected at
// compile time, not just at runtime.
package fail_nocross

import "gno.land/r/test/owned"

func Trigger(cur realm) {
	owned.PublicSet(cur, 99)
}
