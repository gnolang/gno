# Wide-embedding interface satisfaction during preprocess type-checking.
# A 32-method interface, a struct S embedding 32 types (each providing one
# method), and 100 `var xN I = S{}` assignments inside Check(). Each assignment
# runs the checkImplementedBy walk — 32 types expanded, 32×32 entries scanned,
# 32 one-hop trails ≈ 36K gas of walk charge — so the 100 assignments add ≈3.6M
# gas to the deploy (≈14.2M with the walk charge, ≈10.6M without). A 12M budget
# therefore fails only because the walk is billed.

gnoland start

! gnokey maketx addpkg -pkgdir $WORK/p1 -pkgpath gno.land/r/test/p1 -gas-fee 1000000ugnot -gas-wanted 12000000 -chainid tendermint_test test1
stderr 'Data: out of gas error'

# With a budget that covers the walk the same package deploys and runs.
gnokey maketx addpkg -pkgdir $WORK/p1 -pkgpath gno.land/r/test/p1 -gas-fee 1000000ugnot -gas-wanted 80000000 -chainid tendermint_test test1
stdout OK!

gnokey query vm/qeval --data "gno.land/r/test/p1.Check()"
stdout 'true bool'

-- p1/gnomod.toml --
module = "gno.land/r/test/p1"
gno = "0.9"

-- p1/p1.gno --
