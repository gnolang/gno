loadpkg gno.land/r/demo/alice $WORK/alice
loadpkg gno.land/p/demo/peter $WORK/peter
loadpkg gno.land/r/demo/main $WORK/main
gnoland start

# S3: the save is allowed, but the stored closure has no maker. A later call
# runs it view-only, so alice's list is not written.
gnokey maketx call -pkgpath gno.land/r/demo/main -func ExecPreviouslyGood -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout OK!
! gnokey maketx call -pkgpath gno.land/r/demo/alice -func ExecuteClosure -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stderr 'cannot modify object owned by another realm from library code'
gnokey query vm/qeval --data 'gno.land/r/demo/alice.AllowedList[0]'
stdout '1'

# The save and the call in one crossing call: the stored value has no maker
# for this call, so ExecuteClosure runs it read-only.
! gnokey maketx call -pkgpath gno.land/r/demo/main -func ExecSameTx -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stderr 'cannot modify object owned by another realm from library code'
gnokey query vm/qeval --data 'gno.land/r/demo/alice.AllowedList[0]'
stdout '1'

gnokey maketx call -pkgpath gno.land/r/demo/main -func ExecBad -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout OK!
! gnokey maketx call -pkgpath gno.land/r/demo/alice -func ExecuteClosure -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stderr 'cannot modify object owned by another realm from library code'
gnokey query vm/qeval --data 'gno.land/r/demo/alice.AllowedList[0]'
stdout '1'

-- alice/alice.gno --
package alice


var AllowedList = []int{1, 2}

func GetAllowedList() []int {
	return AllowedList
}

var Closure func()

func SetClosure(cur realm, f func()) {
	Closure = f
}

func ExecuteClosure(cur realm) {
	Closure()
}

-- peter/peter.gno --
package peter

func F(v []int) func()   {
	return func()  {
		v[0] = 5
	}
}

-- main/main.gno --
package main

import (
	"gno.land/r/demo/alice"
	"gno.land/p/demo/peter"
)

// A /p/-built closure acts only while the realm it was built under is
// current. peter.F is called from /r/demo/main, so the closure reaches alice
// without a maker. S3 lets alice keep it, but a later call is read-only, so
// alice's list is never written. Alice must build the closure herself.

func ExecPreviouslyGood(cur realm) []int {
	alice.SetClosure(cross(cur), peter.F(alice.GetAllowedList()))
	return alice.AllowedList
}

func ExecSameTx(cur realm) []int {
	alice.SetClosure(cross(cur), peter.F(alice.GetAllowedList()))
	alice.ExecuteClosure(cross(cur))
	return alice.AllowedList
}

func ExecBad(cur realm) []int {
	alice.SetClosure(cross(cur), peter.F(alice.AllowedList))
	return alice.AllowedList
}
