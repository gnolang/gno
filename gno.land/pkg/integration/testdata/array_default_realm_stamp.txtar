# A realm cannot hold another realm's array type by value: r/arruser's
# struct field of type r/arrdecl.A is refused at type check (R3).

loadpkg gno.land/r/arrdecl $WORK/arrdecl
gnoland start

! gnokey maketx addpkg -pkgdir $WORK/arruser -pkgpath gno.land/r/arruser -gas-fee 1000000ugnot -gas-wanted 10000000 -chainid=tendermint_test test1
stderr 'cannot hold a value of gno.land/r/arrdecl.A outside its realm \(use a pointer\)'

gnokey query vm/qeval --data 'gno.land/r/arrdecl.Ready()'
stdout 'true bool'

-- arrdecl/gnomod.toml --
module = "gno.land/r/arrdecl"
gno = "0.9"

-- arrdecl/arrdecl.gno --
package arrdecl

type A [3]int

var stored *A

func Register(a *A) bool {
	if a[0] != 0 {
		return false
	}
	stored = a
	return true
}

func Ready() bool { return stored == nil }

func Set(cur realm, v int) { stored[0] = v }

-- arruser/gnomod.toml --
module = "gno.land/r/arruser"
gno = "0.9"

-- arruser/arruser.gno --
package arruser

import "gno.land/r/arrdecl"

type Local struct{ A arrdecl.A }

var g = &Local{}

func Register(cur realm) { arrdecl.Register(&g.A) }

func Write(cur realm) { g.A[0] = 999 }
