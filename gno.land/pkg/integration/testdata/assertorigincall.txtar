# This test ensures the consistency of the std.AssertOriginCall function, in
# the following situations:
#
# | Num | Msg Type |      Call from      | Entry Point            | Result |
# |-----|:--------:|:-------------------:|:----------------------:|:------:|
# | 1   | MsgCall  | wallet direct       | myrealm.A()            | PANIC  |
# | 2   |          |                     | myrealm.B()            | pass   |
# | 3   |          |                     | myrealm.C()            | pass   |
# | 4   |          | through /r/foo      | myrealm.A()            | PANIC  |
# | 5   |          |                     | myrealm.B()            | pass   |
# | 6   |          |                     | myrealm.C()            | PANIC  |
# | 7   |          | through /p/demo/bar | bar.A()                | PANIC  |
# | 8   |          |                     | bar.B()                | pass   |
# | 9   |          |                     | bar.C()                | PANIC  |
# | 10  | MsgRun   | wallet direct       | myrealm.A()            | PANIC  |
# | 11  |          |                     | myrealm.B()            | pass   |
# | 12  |          |                     | myrealm.C()            | PANIC  |
# | 13  |          | through /r/foo      | myrealm.A()            | PANIC  |
# | 14  |          |                     | myrealm.B()            | pass   |
# | 15  |          |                     | myrealm.C()            | PANIC  |
# | 16  |          | through /p/demo/bar | bar.A()                | PANIC  |
# | 17  |          |                     | bar.B()                | pass   |
# | 18  |          |                     | bar.C()                | PANIC  |
# | 19  | MsgCall  | wallet direct       | std.AssertOriginCall() | pass   |
# | 20  | MsgRun   | wallet direct       | std.AssertOriginCall() | PANIC  |
# | 21  | MsgCall  | wallet direct       | myrealm.D() (func val) | pass   |
# | 22  |          | through /r/foo      | foo.D() (func val)     | PANIC  |
# | 23  |          | through /r/foo      | foo.E() (nested)       | PANIC  |
# | 24  |          | wallet direct       | myrealm.E() (own clo)  | PANIC  |
# | 25  |          |                     | myrealm.F() (own clo)  | PANIC  |
# | 26  |          |                     | myrealm.G() (deferred) | PANIC  |
# | 27  |          | through /r/foo      | myrlm's own closure    | PANIC  |
# | 28  |          | wallet direct       | bar's closure (/p/)    | pass   |
# | 29  |          | wallet direct       | myrlm -> hook -> myrlm | PANIC  |
# | 30  |          | wallet direct       | myrlm -> hook -> clo   | PANIC  |

# Init
## set up and start a new node
loadpkg gno.land/p/demo/bar $WORK/p/demo/bar
loadpkg gno.land/r/myrlm $WORK/r/myrlm
loadpkg gno.land/r/foo $WORK/r/foo
loadpkg gno.land/r/hook $WORK/r/hook

gnoland start

# The PANIC is expected to fail at the transaction simulation stage, which is why we set gas-wanted to 1.

# Test cases
## 1. MsgCall -> myrlm.A -> myrlm.C: PANIC
## C is a named function of myrlm reached from inside myrlm. A script can hand
## myrlm.C back to myrlm as a func value, so any frame myrlm declares above the
## entry is a boundary, closures included (24-26); /p/ helpers (28) are not.
! gnokey maketx call -pkgpath gno.land/r/myrlm -func A -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## 2. MsgCall -> myrlm.B: PASS
gnokey maketx call -pkgpath gno.land/r/myrlm -func B -gas-fee 180001ugnot -gas-wanted 1_800_000 -chainid tendermint_test test1
stdout 'OK!'

## 3. MsgCall -> myrlm.C: PASS
gnokey maketx call -pkgpath gno.land/r/myrlm -func C -gas-fee 180001ugnot -gas-wanted 1_800_000 -chainid tendermint_test test1
stdout 'OK!'

## 4. MsgCall -> r/foo.A -> myrlm.A: PANIC
! gnokey maketx call -pkgpath gno.land/r/foo -func A -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## 5. MsgCall -> r/foo.B -> myrlm.B: PASS
gnokey maketx call -pkgpath gno.land/r/foo -func B -gas-fee 220001ugnot -gas-wanted 2_200_000 -chainid tendermint_test test1
stdout 'OK!'

## 6. MsgCall -> r/foo.C -> myrlm.C: PANIC
! gnokey maketx call -pkgpath gno.land/r/foo -func C -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## remove due to update to maketx call can only call realm (case 7,8,9)
## 7. MsgCall -> p/demo/bar.A: PANIC
## ! gnokey maketx call -pkgpath gno.land/p/demo/bar -func A -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
## stderr 'invalid non-origin call'

## 8. MsgCall -> p/demo/bar.B: PASS
## gnokey maketx call -pkgpath gno.land/p/demo/bar -func B -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
## stdout 'OK!'

## 9. MsgCall -> p/demo/bar.C: PANIC
## ! gnokey maketx call -pkgpath gno.land/p/demo/bar -func C -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
## stderr 'invalid non-origin call'

## 10. MsgRun -> run.main -> myrlm.A: PANIC
! gnokey maketx run -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1 $WORK/run/myrlm-a.gno
stderr 'invalid non-origin call'

## 11. MsgRun -> run.main -> myrlm.B: PASS
gnokey maketx run -gas-fee 150001ugnot -gas-wanted 2_000_000 -chainid tendermint_test test1 $WORK/run/myrlm-b.gno
stdout 'OK!'

## 12. MsgRun -> run.main -> myrlm.C: PANIC
! gnokey maketx run -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1 $WORK/run/myrlm-c.gno
stderr 'invalid non-origin call'

## 13. MsgRun -> run.main -> foo.A: PANIC
! gnokey maketx run -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1 $WORK/run/foo-a.gno
stderr 'invalid non-origin call'

## 14. MsgRun -> run.main -> foo.B: PASS
gnokey maketx run -gas-fee 210001ugnot -gas-wanted 2_100_000 -chainid tendermint_test test1 $WORK/run/foo-b.gno
stdout 'OK!'

## 15. MsgRun -> run.main -> foo.C: PANIC
! gnokey maketx run -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1 $WORK/run/foo-c.gno
stderr 'invalid non-origin call'

## 16. MsgRun -> run.main -> bar.A: PANIC
! gnokey maketx run -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1 $WORK/run/bar-a.gno
stderr 'invalid non-origin call'

## 17. MsgRun -> run.main -> bar.B: PASS
gnokey maketx run -gas-fee 150001ugnot -gas-wanted 1_500_000 -chainid tendermint_test test1 $WORK/run/bar-b.gno
stdout 'OK!'

## 18. MsgRun -> run.main -> bar.C: PANIC
! gnokey maketx run -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1 $WORK/run/bar-c.gno
stderr 'invalid non-origin call'

## remove testcase 19 due to maketx call forced to call a realm
## 19. MsgCall -> std.AssertOriginCall: pass
## gnokey maketx call -pkgpath std -func AssertOriginCall -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
## stdout 'OK!'

## 20. MsgRun -> std.AssertOriginCall: PANIC
! gnokey maketx run -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1 $WORK/run/baz.gno
stderr 'invalid non-origin call'

## A func literal is a legitimate entry point, and a call boundary when it
## sits above one. Cases 21-23 pin both halves: myrlm.D is the entry itself
## and passes, but foo's func values are another realm's frames above
## myrlm.C, so they count like foo's named functions.

## 21. MsgCall -> myrlm.D (func value): PASS
gnokey maketx call -pkgpath gno.land/r/myrlm -func D -gas-fee 180001ugnot -gas-wanted 1_800_000 -chainid tendermint_test test1
stdout 'OK!'

## 22. MsgCall -> r/foo.D (func value) -> myrlm.C: PANIC
! gnokey maketx call -pkgpath gno.land/r/foo -func D -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## 23. MsgCall -> r/foo.E (func value, inner closure crosses) -> myrlm.C: PANIC
! gnokey maketx call -pkgpath gno.land/r/foo -func E -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## A realm's OWN func literal above the entry is a boundary like its named
## functions: a closure the realm exports or returns is a value a script can
## hand back. The crossing flags do not decide it (24 sets DidCrossing via the
## inherited-cur path, 25 sets WithCross); the declaring realm does.

## 24. MsgCall -> myrlm.E -> own crossing closure, called as f(cur): PANIC
! gnokey maketx call -pkgpath gno.land/r/myrlm -func E -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## 25. MsgCall -> myrlm.F -> own crossing closure, called as f(cross(cur)): PANIC
! gnokey maketx call -pkgpath gno.land/r/myrlm -func F -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## 26. MsgCall -> myrlm.G -> own crossing closure, deferred: PANIC
## The defer path builds its frame in doOpReturnCallDefers rather than doOpCall
## and reaches installInheritedCur separately, so it gets its own case.
! gnokey maketx call -pkgpath gno.land/r/myrlm -func G -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## A plain call into ANOTHER realm's exported closure sets no crossing flag at
## all, yet the closure runs with that realm's storage authority. 27 and 28 are
## the two sides of it: a foreign realm's closure is a boundary, a pure
## package's closure is not, because /p/ borrows the caller's storage.

## 27. MsgCall -> r/foo.G -> myrlm's own non-crossing closure: PANIC
! gnokey maketx call -pkgpath gno.land/r/foo -func G -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## 28. MsgCall -> myrlm.H -> p/demo/bar's non-crossing closure: PASS
gnokey maketx call -pkgpath gno.land/r/myrlm -func H -gas-fee 250001ugnot -gas-wanted 2_500_000 -chainid tendermint_test test1
stdout 'OK!'

## Re-entry: the ENTRY realm is myrlm, another realm sits on the stack, and
## myrlm's own code runs again above it. The walk counts myrlm, hook, myrlm:
## three boundaries, one more than any case above, and the body realm of the
## re-entrant frame equals the entry realm's while the realm below it does not.
## 29. MsgCall -> myrlm.I -> r/hook.Notify -> myrlm.C: PANIC
! gnokey maketx call -pkgpath gno.land/r/myrlm -func I -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'

## 30. MsgCall -> myrlm.J -> r/hook.Run -> myrlm's own closure: PANIC
! gnokey maketx call -pkgpath gno.land/r/myrlm -func J -gas-fee 5000000ugnot -gas-wanted 50000000 -chainid tendermint_test test1
stderr 'invalid non-origin call'


-- r/myrlm/rlm.gno --
package myrlm

import (
	"chain/runtime"

	"gno.land/p/demo/bar"
)

func A(cur realm) {
	C(cur)
}

func B(cur realm) {
	if false {
		C(cur)
	}
}

func C(cur realm) {
	runtime.AssertOriginCall()
}

// D is an entry point held in a variable rather than declared. Nothing
// crosses a realm here, so it is the same call as B or C.
var D = func(cur realm) {
	runtime.AssertOriginCall()
}

// E and F call a crossing func literal belonging to myrlm itself. The
// literal is myrlm's own function above the entry, so it is a boundary
// however it is invoked: E forwards cur directly, F crosses to it.
func E(cur realm) {
	f := func(cur realm) {
		runtime.AssertOriginCall()
	}
	f(cur)
}

func F(cur realm) {
	f := func(cur realm) {
		runtime.AssertOriginCall()
	}
	f(cross(cur))
}

func G(cur realm) {
	f := func(cur realm) {
		runtime.AssertOriginCall()
	}
	defer f(cur)
}

// Check is myrlm's own closure, exported and non-crossing. Another realm can
// call it, and it then runs with myrlm's storage authority.
var Check = func() {
	runtime.AssertOriginCall()
}

// H reaches a closure in a pure package, which borrows myrlm's storage and so
// is myrlm's own code.
func H(cur realm) {
	bar.Check()
}

// Hook is registered by r/hook at init; myrlm cannot import it back.
type Hook interface {
	Notify(cur realm)
	Run(f func())
}

var hook Hook

func SetHook(cur realm, h Hook) {
	hook = h
}

// I and J re-enter myrlm from r/hook: I by a cross-call back into C, J by
// handing hook a closure of myrlm's own. Either way hook is on the stack.
func I(cur realm) {
	hook.Notify(cross(cur))
}

func J(cur realm) {
	hook.Run(func() {
		runtime.AssertOriginCall()
	})
}
-- r/foo/foo.gno --
package foo

import "gno.land/r/myrlm"

func A(cur realm) {
	myrlm.A(cross(cur))
}

func B(cur realm) {
	myrlm.B(cross(cur))
}

func C(cur realm) {
	myrlm.C(cross(cur))
}

// D is C held in a variable. myrlm is still entered from foo, so foo's frame
// has to count.
var D = func(cur realm) {
	myrlm.C(cross(cur))
}

// E puts a second, same-realm closure between the entry point and the
// crossing. Only the frame that crosses counts, and one of them does.
var E = func(cur realm) {
	func() {
		myrlm.C(cross(cur))
	}()
}

// G calls myrlm's exported closure without crossing. No flag is set, but the
// closure runs as myrlm, so foo is an intermediary all the same.
func G(cur realm) {
	myrlm.Check()
}
-- r/hook/hook.gno --
package hook

import "gno.land/r/myrlm"

type h struct{}

func (h) Notify(cur realm) {
	myrlm.C(cross(cur))
}

func (h) Run(f func()) {
	f()
}

func init(cur realm) {
	myrlm.SetHook(cross(cur), h{})
}

-- p/demo/bar/bar.gno --
package bar

import "chain/runtime"

func A() {
	C()
}

func B() {
	if false {
		C()
	}
}
func C() {
	runtime.AssertOriginCall()
}

// Check is a closure in a PURE package. It borrows its caller's storage, so
// calling it is not a realm boundary.
var Check = func() {
	runtime.AssertOriginCall()
}
-- run/myrlm-a.gno --
