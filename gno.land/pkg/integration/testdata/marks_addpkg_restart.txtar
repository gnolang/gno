# Packages deployed by addpkg in the running node get their load-time marks from
# that deploy; after a restart they get them from re-preprocessing the stored
# source. Writes and refusals match both times, also for a realm whose callee
# realm is first loaded after the restart as its import.

loadpkg gno.land/p/demo/tests/t56lib
gnoland start

gnokey maketx addpkg -pkgdir $WORK/inner -pkgpath gno.land/r/$test1_user_addr/t56inner -gas-fee 1000000ugnot -gas-wanted 30_000_000 -chainid=tendermint_test test1
stdout 'OK!'
gnokey maketx addpkg -pkgdir $WORK/outer -pkgpath gno.land/r/$test1_user_addr/t56outer -gas-fee 1000000ugnot -gas-wanted 30_000_000 -chainid=tendermint_test test1
stdout 'OK!'

# (a) local helper writes; (b) a literal lent to t56lib.Run writes.
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56inner -func Helper -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(1 int\)'
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56inner -func Lend -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(2 int\)'
# Their unmarked twins are refused and leave count at 2.
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56inner -func Refused -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(true bool\)\n\(true bool\)\n\(2 int\)'
# (c) both, through t56outer.
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56outer -func Both -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(4 int\)'
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56outer -func Refused -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(true bool\)\n\(true bool\)\n\(4 int\)'

gnoland restart

# (c) first, so t56inner is loaded only as t56outer's import.
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56outer -func Both -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(6 int\)'
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56outer -func Refused -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(true bool\)\n\(true bool\)\n\(6 int\)'
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56inner -func Helper -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(7 int\)'
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56inner -func Lend -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(8 int\)'
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56inner -func Refused -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(true bool\)\n\(true bool\)\n\(8 int\)'

# A second restart: the rebuilt marks are rebuilt again the same way.
gnoland restart

gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56inner -func Lend -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(9 int\)'
gnokey maketx call -pkgpath gno.land/r/$test1_user_addr/t56inner -func Refused -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '\(true bool\)\n\(true bool\)\n\(9 int\)'

-- inner/gnomod.toml --
module = "gno.land/r/g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5/t56inner"
gno = "0.9"

-- inner/inner.gno --
package t56inner

import "gno.land/p/demo/tests/t56lib"

var count int

func Helper(cur realm) int {
	f := func() { count++ }
	f()
	return count
}

func Lend(cur realm) int {
	t56lib.Run(func() { count++ })
	return count
}

func Both(cur realm) int {
	f := func() { count++ }
	f()
	t56lib.Run(func() { count++ })
	return count
}

// Refused: f assigned twice is no helper; w passed by name is not lent.
func Refused(cur realm) (helperRefused, lendRefused bool, n int) {
	func() {
		defer func() { helperRefused = recover() != nil }()
		var f func()
		f = func() { count++ }
		f = func() { count += 100 }
		f()
	}()
	func() {
		defer func() { lendRefused = recover() != nil }()
		w := func() { count++ }
		t56lib.Run(w)
	}()
	return helperRefused, lendRefused, count
}

-- outer/gnomod.toml --
module = "gno.land/r/g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5/t56outer"
gno = "0.9"

-- outer/outer.gno --
package t56outer

import "gno.land/r/g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5/t56inner"

func Both(cur realm) int { return t56inner.Both(cross(cur)) }

func Refused(cur realm) (bool, bool, int) { return t56inner.Refused(cross(cur)) }
