# A sponsor that cannot pay is rejected at admission: CheckTx dry-runs the
# settlement, and the bank refuses the debit. Simulate runs the same dry run.

## start a new node
gnoland start

## deploy a realm that calls PayGas
gnokey maketx addpkg -pkgdir $WORK/broke -pkgpath gno.land/r/test/broke -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout OK!

## do NOT fund the realm — it has 0 gnot

## call with 0-fee — realm calls PayGas but has no balance. Skip gnokey's own
## simulation so the tx reaches admission, which refuses it.
! gnokey maketx call -pkgpath gno.land/r/test/broke -func DoWork -gas-fee 0ugnot -gas-wanted 5000000 -simulate skip -broadcast -chainid=tendermint_test test1
stderr 'check transaction failed'
stderr 'insufficient coins'
stderr 'insufficient account funds'

## a wallet's simulation already shows it (a dry run, never broadcast)
! gnokey maketx call -pkgpath gno.land/r/test/broke -func DoWork -gas-fee 0ugnot -gas-wanted 5000000 -simulate only -broadcast -chainid=tendermint_test test1
stderr 'insufficient coins'

-- broke/gnomod.toml --
module = "broke"
gno = "0.9"

-- broke/broke.gno --
package broke

import "chain/runtime"

func DoWork(cur realm) string {
	runtime.PayGas(1000000, cur)
	return "done"
}
