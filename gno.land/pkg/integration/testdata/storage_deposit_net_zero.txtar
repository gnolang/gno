# Net-zero aggregate storage still persists the params baseline for a later refund.
gnoland start

gnokey maketx addpkg -pkgdir $WORK/realm -pkgpath gno.land/r/nz -gas-fee 380001ugnot -gas-wanted 5_000_000 -max-deposit 2000000ugnot -chainid=tendermint_test test1
stdout OK!

gnokey query vm/qstorage --data gno.land/r/nz
stdout 'storage: 3294, deposit: 329400'

gnokey maketx call -pkgpath gno.land/r/nz -func NetZero -args "" -gas-fee 380001ugnot -gas-wanted 5_000_000 -max-deposit 2000000ugnot -chainid=tendermint_test test1
stdout OK!
stdout 'EVENTS:     \[\]'
! stdout 'STORAGE DELTA'
! stdout 'STORAGE FEE'
! stdout 'STORAGE REFUND'

gnokey query vm/qstorage --data gno.land/r/nz
stdout 'storage: 3294, deposit: 329400'

gnokey maketx call -pkgpath gno.land/r/nz -func DelP -gas-fee 380001ugnot -gas-wanted 5_000_000 -max-deposit 2000000ugnot -chainid=tendermint_test test1
stdout OK!
stdout 'STORAGE DELTA:  -502 bytes'
stdout 'STORAGE REFUND: 50200ugnot'
stdout 'EVENTS:     \[{"bytes_delta":-502,"fee_refund":{"denom":"ugnot","amount":50200},"pkg_path":"gno.land/r/nz","refund_withheld":false}\]'

gnokey query vm/qstorage --data gno.land/r/nz
stdout 'storage: 2792, deposit: 279200'

-- realm/gnomod.toml --
module = "gno.land/r/nz"

gno = "0.9"

-- realm/nz.gno --
package nz

import (
	params_ "chain/params"
)

var Blob = make([]byte, 200)

func NetZero(cur realm, val string) {
	Blob = nil
	params_.SetBytes("k", []byte(val))
}

func DelP(cur realm) {
	params_.SetBytes("k", nil)
}
