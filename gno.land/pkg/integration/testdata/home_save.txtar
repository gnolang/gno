# Saving a function value that arrived without a maker is allowed; loaded from
# the store it has no crossing id, so a later call runs read-only: refused into
# the realm whose code it is, refused when its code is a library's, kept by a
# third realm, where it runs read-only for its code's realm.

loadpkg gno.land/p/demo/tests/pfuncbind
loadpkg gno.land/r/demo/hv $WORK/hv
loadpkg gno.land/r/demo/hz $WORK/hz
gnoland start

## HandOwn saves hv's own function; a later RunHook is refused, Owner unchanged
gnokey maketx call -pkgpath gno.land/r/demo/hz -func HandOwn -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stdout OK!
! gnokey maketx call -pkgpath gno.land/r/demo/hv -func RunHook -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/demo/hv''s code is read-only here: a function value writes only as a literal passed in place or called where it is written'
gnokey query vm/qeval --data 'gno.land/r/demo/hv.Owner'
stdout 'orig'

## HandLib saves a library writer; a later RunLib is refused, imm unchanged
gnokey maketx call -pkgpath gno.land/r/demo/hz -func HandLib -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stdout OK!
! gnokey maketx call -pkgpath gno.land/r/demo/hv -func RunLib -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'cannot modify object owned by another realm from library code'
gnokey query vm/qeval --data 'gno.land/r/demo/hv.ReadImm()'
stdout 'orig'

## KeepLib keeps a library writer in hz; a later hz.RunLib is refused
gnokey maketx call -pkgpath gno.land/r/demo/hz -func KeepLib -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stdout OK!
! gnokey maketx call -pkgpath gno.land/r/demo/hz -func RunLib -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'cannot modify object owned by another realm from library code'
gnokey query vm/qeval --data 'gno.land/r/demo/hz.ReadLib()'
stdout 'orig'

gnokey maketx call -pkgpath gno.land/r/demo/hz -func Keep -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
! gnokey maketx call -pkgpath gno.land/r/demo/hz -func RunKept -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/demo/hv''s code was entered without crossing and is read-only'

gnokey query vm/qeval --data 'gno.land/r/demo/hv.Owner'
stdout 'orig'

-- hv/gnomod.toml --
module = "gno.land/r/demo/hv"
gno = "0.9"

-- hv/hv.gno --
package hv

import (
	"gno.land/p/demo/tests/launderpkg/v0"
	"gno.land/p/demo/tests/pfuncbind"
)

var (
	Owner = "orig"
	FV    = set
	LibFV = pfuncbind.Clobber
	hook  func(string)
	lib   func(*launderpkg.Immutable)
	imm   = &launderpkg.Immutable{Field: "orig"}
)

func set(s string) { Owner = s }

func SetHook(cur realm, f func(string))                  { hook = f }
func SetLib(cur realm, f func(*launderpkg.Immutable)) { lib = f }

func RunHook(cur realm) { hook("hooked") }
func RunLib(cur realm)  { lib(imm) }
func ReadImm() string   { return imm.Field }

-- hz/gnomod.toml --
module = "gno.land/r/demo/hz"
gno = "0.9"

-- hz/hz.gno --
package hz

import (
	"gno.land/p/demo/tests/launderpkg/v0"
	"gno.land/r/demo/hv"
)

var (
	kept func(string)
	lib  func(*launderpkg.Immutable)
	obj  = &launderpkg.Immutable{Field: "orig"}
)

func HandOwn(cur realm) { hv.SetHook(cross(cur), hv.FV) }
func HandLib(cur realm) { hv.SetLib(cross(cur), hv.LibFV) }
func KeepLib(cur realm) { lib = hv.LibFV }
func Keep(cur realm)    { kept = hv.FV }
func RunKept(cur realm) { kept("kept") }
func RunLib(cur realm)  { lib(obj) }
func ReadLib() string   { return obj.Field }
