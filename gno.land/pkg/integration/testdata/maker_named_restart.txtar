# A realm gate calling its own non-crossing function by name writes; the same
# function called through a value runs read-only. Both hold after a restart,
# when the call marks are rebuilt by preprocessing.

loadpkg gno.land/r/test/mknamed $WORK
gnoland start

gnokey maketx call -pkgpath gno.land/r/test/mknamed -func Named -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '"named" string'

! gnokey maketx call -pkgpath gno.land/r/test/mknamed -func ViaValue -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stderr 'gno.land/r/test/mknamed''s code was entered without crossing and is read-only'

gnoland restart

gnokey maketx call -pkgpath gno.land/r/test/mknamed -func Named -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '"named" string'

! gnokey maketx call -pkgpath gno.land/r/test/mknamed -func ViaValue -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stderr 'gno.land/r/test/mknamed''s code was entered without crossing and is read-only'

-- gnomod.toml --
module = "gno.land/r/test/mknamed"
gno = "0.9"

-- mknamed.gno --
package mknamed

var state = "orig"

func set(s string) { state = s }

func Named(cur realm) string {
	set("named")
	return state
}

func ViaValue(cur realm) string {
	f := set
	f("value")
	return state
}
