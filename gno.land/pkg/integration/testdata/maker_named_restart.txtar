# A realm gate calling its own non-crossing function by name writes, and so do
# a local helper and a local bound once to it; the function read from a package
# variable is refused. All four hold after a restart, when preprocessing reruns.

loadpkg gno.land/r/test/mknamed $WORK
gnoland start

gnokey maketx call -pkgpath gno.land/r/test/mknamed -func Named -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '"named" string'

gnokey maketx call -pkgpath gno.land/r/test/mknamed -func ViaHelper -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '"helper" string'

gnokey maketx call -pkgpath gno.land/r/test/mknamed -func ViaAlias -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '"alias" string'

! gnokey maketx call -pkgpath gno.land/r/test/mknamed -func ViaValue -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stderr 'read-only here'

gnoland restart

gnokey maketx call -pkgpath gno.land/r/test/mknamed -func Named -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '"named" string'

gnokey maketx call -pkgpath gno.land/r/test/mknamed -func ViaHelper -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '"helper" string'

gnokey maketx call -pkgpath gno.land/r/test/mknamed -func ViaAlias -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stdout '"alias" string'

! gnokey maketx call -pkgpath gno.land/r/test/mknamed -func ViaValue -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid tendermint_test test1
stderr 'read-only here'

-- gnomod.toml --
module = "gno.land/r/test/mknamed"
gno = "0.9"

-- mknamed.gno --
package mknamed

var state = "orig"

func set(s string) { state = s }

var setFn = set

func Named(cur realm) string {
	set("named")
	return state
}

func ViaHelper(cur realm) string {
	f := func(s string) { set(s) }
	f("helper")
	return state
}

func ViaValue(cur realm) string {
	f := setFn
	f("value")
	return state
}

func ViaAlias(cur realm) string {
	f := set
	f("alias")
	return state
}
