# Governance lifecycle on a real node: invite gating, proposal withdrawal,
# and the home-index listing toggle — the non-treasury entry points the
# treasury txtar never exercises.

loadpkg gno.land/r/nt/commondao/v0

adduser test2

# Genesis council collapses to test1, so test1 is the realm's inviter.
patchpkg g16jpf0puufcpcjkph5nxueec8etpcldz7zwgydq $test1_user_addr
patchpkg g1manfred47kzduec920z88wfr64ylksmdcedlf5 $test1_user_addr

gnoland start

# --- Invite gating: creating a DAO requires an invitation ---

# test2 has no invite: New is rejected.
! gnokey maketx call -pkgpath gno.land/r/nt/commondao/v0 -func New -args 'Foo' -args 'Purpose' -args '' -args '' -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test2
stderr 'unauthorized'

# test1 (genesis council) invites test2, who can now create a DAO (id 2).
gnokey maketx call -pkgpath gno.land/r/nt/commondao/v0 -func Invite -args $test2_user_addr -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'
gnokey maketx call -pkgpath gno.land/r/nt/commondao/v0 -func New -args 'Foo' -args 'Purpose' -args '' -args '' -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test2
stdout 'OK!'

# --- Withdraw: the creator pulls an un-voted proposal ---

gnokey maketx call -pkgpath gno.land/r/nt/commondao/v0 -func CreateTextProposal -args 2 -args 'Title' -args 'Body' -args 0 -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test2
stdout 'OK!'
gnokey maketx call -pkgpath gno.land/r/nt/commondao/v0 -func Withdraw -args 2 -args 1 -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test2
stdout 'OK!'

# A withdrawn proposal has left the active store: it cannot be executed.
! gnokey maketx call -pkgpath gno.land/r/nt/commondao/v0 -func Execute -args 2 -args 1 -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test2
stderr 'proposal not found'

# --- Listing toggle: a council member flips the home-index bit ---

gnokey query vm/qeval --data 'gno.land/r/nt/commondao/v0.IsListed(2)'
stdout 'false'

gnokey maketx call -pkgpath gno.land/r/nt/commondao/v0 -func SetListed -args 2 -args true -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test2
stdout 'OK!'
gnokey query vm/qeval --data 'gno.land/r/nt/commondao/v0.IsListed(2)'
stdout 'true'

gnokey maketx call -pkgpath gno.land/r/nt/commondao/v0 -func SetListed -args 2 -args false -gas-fee 1000000ugnot -gas-wanted 50000000 -broadcast -chainid=tendermint_test test2
stdout 'OK!'
gnokey query vm/qeval --data 'gno.land/r/nt/commondao/v0.IsListed(2)'
stdout 'false'
