# A closure realm A wrote and stored from its own gate writes for A when A's
# gate calls it later. Realm B reading it through A's exported variable and
# calling it directly runs it read-only; B handing it back to A's callback
# gate lets it write (a closure a realm made in a gate is a key to its gates).

loadpkg gno.land/r/demo/mka $WORK/mka
loadpkg gno.land/r/demo/mkb $WORK/mkb

gnoland start

gnokey maketx call -pkgpath gno.land/r/demo/mka -func Save -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
gnokey maketx call -pkgpath gno.land/r/demo/mka -func Fire -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
gnokey query vm/qeval --data 'gno.land/r/demo/mka.Val'
stdout 'fired'

! gnokey maketx call -pkgpath gno.land/r/demo/mkb -func Direct -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/demo/mka''s code was entered without crossing and is read-only'
gnokey query vm/qeval --data 'gno.land/r/demo/mka.Val'
stdout 'fired'

gnokey maketx call -pkgpath gno.land/r/demo/mkb -func HandBack -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
gnokey query vm/qeval --data 'gno.land/r/demo/mka.Val'
stdout 'handed'

-- mka/gnomod.toml --
module = "gno.land/r/demo/mka"
gno = "0.9"

-- mka/mka.gno --
package mka

var (
	Val  = "orig"
	Hook func(string)
)

func Save(cur realm)                 { Hook = func(s string) { Val = s } }
func Fire(cur realm)                 { Hook("fired") }
func RunS(cur realm, f func(string)) { f("handed") }

-- mkb/gnomod.toml --
module = "gno.land/r/demo/mkb"
gno = "0.9"

-- mkb/mkb.gno --
package mkb

import "gno.land/r/demo/mka"

func Direct(cur realm)   { mka.Hook("b-direct") }
func HandBack(cur realm) { mka.RunS(cross(cur), mka.Hook) }
