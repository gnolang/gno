# A keyed route is proven against grc20factory EXACTLY AS DEPLOYED.
#
# grc20factory is live on mainnet and cannot be redeployed, so it can never call
# grc20routes.Register. This asserts that it does not have to: its shape is
# established from the outside, by effect, using nothing but calls it already
# exposes. No package under test is modified — grc20factory is loaded from
# examples/ unchanged.
#
# The order below is the point:
#
#   (a) before the proof, the route reads as the canonical convention, which is
#       WRONG for this realm — a consumer following it would build
#       Approve(spender, amount) and abort on arity;
#   (b) the proof moves TWO different tokens' allowances at the one realm, which
#       an unkeyed Approve cannot do;
#   (c) after it, every token on the realm resolves to Keyed(<its own symbol>) —
#       including one minted afterwards, which the proof never named.
#
# The probe address g1v58us0p32wfaxfnhzqwd72hpu56fg4ktfkhyep is
# grc20routes' own realm address, where the proof parks its throwaway allowance.

loadpkg gno.land/r/demo/defi/grc20factory
loadpkg gno.land/r/gnoland/wugnot
loadpkg gno.land/r/nt/grc20routes/v0
loadpkg gno.land/r/demo/zvictim $WORK/zvictim
loadpkg gno.land/r/demo/zforger $WORK/zforger

adduser alice

gnoland start

gnokey maketx send -send 50000000ugnot -to $alice_user_addr -gas-fee 1000000ugnot -gas-wanted 10000000 -broadcast -chainid tendermint_test test1
stdout 'OK!'

# Alice mints two tokens through the factory. Both land in grc20reg under
# gno.land/r/demo/defi/grc20factory.<SYMBOL>.
gnokey maketx call -pkgpath gno.land/r/demo/defi/grc20factory -func New -args Foo -args FOO -args 6 -args 1000000 -args 0 -gas-fee 1000000ugnot -gas-wanted 20000000 -broadcast -chainid tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/demo/defi/grc20factory -func New -args Bar -args BAR -args 6 -args 1000000 -args 0 -gas-fee 1000000ugnot -gas-wanted 20000000 -broadcast -chainid tendermint_test alice
stdout 'OK!'

# (a) Before the proof: the convention, and it is the wrong answer for this realm.
gnokey query vm/qeval --data "gno.land/r/nt/grc20routes/v0.JSON(\"gno.land/r/demo/defi/grc20factory.FOO\")"
stdout '\\"prefix\\":\[\],\\"source\\":\\"convention\\"'

# (b) The proof. Four calls, no privileged operation among them: Approve is
# something any holder may already do.
gnokey maketx call -pkgpath gno.land/r/nt/grc20routes/v0 -func BeginKeyedProof -args gno.land/r/demo/defi/grc20factory.FOO -args gno.land/r/demo/defi/grc20factory.BAR -args 111 -args 222 -gas-fee 1000000ugnot -gas-wanted 20000000 -broadcast -chainid tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/demo/defi/grc20factory -func Approve -args FOO -args g1v58us0p32wfaxfnhzqwd72hpu56fg4ktfkhyep -args 111 -gas-fee 1000000ugnot -gas-wanted 20000000 -broadcast -chainid tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/demo/defi/grc20factory -func Approve -args BAR -args g1v58us0p32wfaxfnhzqwd72hpu56fg4ktfkhyep -args 222 -gas-fee 1000000ugnot -gas-wanted 20000000 -broadcast -chainid tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/nt/grc20routes/v0 -func FinishKeyedProof -args gno.land/r/demo/defi/grc20factory.FOO -args gno.land/r/demo/defi/grc20factory.BAR -gas-fee 1000000ugnot -gas-wanted 20000000 -broadcast -chainid tendermint_test alice
stdout 'OK!'

# (c) After: both proven tokens, keyed by their own symbol.
gnokey query vm/qeval --data "gno.land/r/nt/grc20routes/v0.JSON(\"gno.land/r/demo/defi/grc20factory.FOO\")"
stdout '\\"prefix\\":\[\\"FOO\\"\],\\"source\\":\\"proven\\"'

gnokey query vm/qeval --data "gno.land/r/nt/grc20routes/v0.JSON(\"gno.land/r/demo/defi/grc20factory.BAR\")"
stdout '\\"prefix\\":\[\\"BAR\\"\],\\"source\\":\\"proven\\"'
stdout '\\"funcs\\":{\\"approve\\":\\"Approve\\",\\"transfer\\":\\"Transfer\\",\\"transfer_from\\":\\"TransferFrom\\"}'

# ...and a token minted after the fact, which no proof ever named. One proof
# covers the realm, not a token, which is what makes this tractable for a
# factory already hosting dozens of them.
gnokey maketx call -pkgpath gno.land/r/demo/defi/grc20factory -func New -args Baz -args BAZ -args 6 -args 1000000 -args 0 -gas-fee 1000000ugnot -gas-wanted 20000000 -broadcast -chainid tendermint_test alice
stdout 'OK!'

gnokey query vm/qeval --data "gno.land/r/nt/grc20routes/v0.JSON(\"gno.land/r/demo/defi/grc20factory.BAZ\")"
stdout '\\"prefix\\":\[\\"BAZ\\"\],\\"source\\":\\"proven\\"'

# Proving one realm keyed says nothing about any other. wugnot is a single-token
# realm and still reads as the convention, which for it is the right answer.
gnokey query vm/qeval --data "gno.land/r/nt/grc20routes/v0.JSON(\"gno.land/r/gnoland/wugnot.wugnot\")"
stdout '\\"pkg_path\\":\\"gno.land/r/gnoland/wugnot\\"'
stdout '\\"prefix\\":\[\],\\"source\\":\\"convention\\"'

# A realm prover is refused. grc20reg.Approve sets the CALLING realm's own
# allowance on any registered token, so a realm could otherwise make both nonces
# land without calling the token's realm at all. zvictim hosts two tokens and
# exposes no Approve of any arity; it must not be markable as keyed.
! gnokey maketx call -pkgpath gno.land/r/demo/zforger -func Forge -args gno.land/r/demo/zvictim.VICA -args gno.land/r/demo/zvictim.VICB -args 333 -args 444 -gas-fee 1000000ugnot -gas-wanted 40000000 -broadcast -chainid tendermint_test alice
stderr 'a keyed proof must be sent by a signing user with MsgCall'

gnokey query vm/qeval --data "gno.land/r/nt/grc20routes/v0.IsKeyedRealm(\"gno.land/r/demo/zvictim\")"
stdout 'false'

-- zvictim/gnomod.toml --
module = "gno.land/r/demo/zvictim"
gno = "0.9"

-- zvictim/zvictim.gno --
// zvictim hosts two registered tokens and exposes no write entry point.
package zvictim

import (
	"gno.land/p/nt/grc20/v0"
	"gno.land/p/nt/seqid/v0"

	"gno.land/r/nt/grc20reg/v0"
)

var id seqid.ID

func init(cur realm) {
	a, _ := grc20.NewToken("Victim A", "VICA", 6, id.Next(), cur)
	grc20reg.Register(cross(cur), a, "")
	b, _ := grc20.NewToken("Victim B", "VICB", 6, id.Next(), cur)
	grc20reg.Register(cross(cur), b, "")
}

-- zforger/gnomod.toml --
module = "gno.land/r/demo/zforger"
gno = "0.9"

-- zforger/zforger.gno --
package zforger

import (
	"gno.land/r/nt/grc20reg/v0"
	"gno.land/r/nt/grc20routes/v0"
)

// Forge runs the four proof calls from a realm, producing both allowances
// through grc20reg instead of through the token's own realm.
func Forge(cur realm, keyA, keyB string, nonceA, nonceB int64) {
	grc20routes.BeginKeyedProof(cross(cur), keyA, keyB, nonceA, nonceB)
	grc20reg.Approve(0, cur, keyA, grc20routes.ProbeAddress(), nonceA)
	grc20reg.Approve(0, cur, keyB, grc20routes.ProbeAddress(), nonceB)
	grc20routes.FinishKeyedProof(cross(cur), keyA, keyB)
}
