# Phase 2: a realm forwards a native-coin payment to another realm within one
# message (banker.PayCall), and the payee reads exactly what it was forwarded
# via banker.CallSend(). This is the composition the message-entry receipt alone
# cannot express. See docs/proposals/per-call-coin-value.md.

loadpkg gno.land/r/test/wrap $WORK/wrap
loadpkg gno.land/r/test/router $WORK/router

adduser user1
gnoland start

# user1 -> router.Route with 5000ugnot. The router is the message recipient, so
# CallSend() reports 5000 to it; it then PayCall-forwards all 5000 to wrap and
# calls wrap.Deposit, which reads the forwarded 5000 via CallSend and mints.
gnokey maketx call -pkgpath gno.land/r/test/router -func Route -send 5000ugnot -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test user1
stdout 'OK!'

# wrap saw the forwarded amount (not zero — it is not the message recipient):
gnokey query vm/qeval --data "gno.land/r/test/wrap.GetMinted()"
stdout '5000 int64'

# and the coins actually moved into wrap's own address:
gnokey query vm/qeval --data "gno.land/r/test/wrap.Bal()"
stdout '5000 int64'

-- wrap/gnomod.toml --
module = "gno.land/r/test/wrap"
gno = "0.9"

-- wrap/wrap.gno --
package wrap

import (
	"chain"
	"chain/banker"
)

var minted int64

// Deposit mints against the coins forwarded to wrap on THIS call.
func Deposit(cur realm) {
	minted += banker.CallSend().AmountOf("ugnot")
}

func GetMinted() int64 { return minted }

func Bal() int64 {
	return banker.NewReadonlyBanker().GetCoin(chain.PackageAddress("gno.land/r/test/wrap"), "ugnot")
}

-- router/gnomod.toml --
module = "gno.land/r/test/router"
gno = "0.9"

-- router/router.gno --
package router

import (
	"chain"
	"chain/banker"

	"gno.land/r/test/wrap"
)

// Route receives the user's ugnot, forwards it to wrap within the same message,
// then calls wrap so wrap can mint against exactly what was forwarded.
func Route(cur realm) {
	got := banker.CallSend().AmountOf("ugnot")
	banker.PayCall("gno.land/r/test/wrap", cur, chain.Coins{{"ugnot", got}})
	wrap.Deposit(cross(cur))
}
