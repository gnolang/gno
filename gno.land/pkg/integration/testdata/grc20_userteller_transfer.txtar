# The token explicitly delegates a private UserTeller to the proxy fixture.
# Delegated PrivateLedger.UserTeller Transfer scenarios. A direct MsgCall EOA may transfer
# from its own account through a proxy, while an intermediate realm, a callback,
# a stale realm value, and MsgRun cannot use that authority.

loadpkg gno.land/p/demo/tokens/grc20
loadpkg gno.land/r/test/transfertok $WORK/transfertok
loadpkg gno.land/r/test/proxy $WORK/proxy
loadpkg gno.land/r/test/transfer_midx $WORK/midx

adduser alice
adduser bob

gnoland start

# Alice owns 1,000 tokens and can transfer them through the proxy.
gnokey maketx call -pkgpath gno.land/r/test/transfertok -func Faucet -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test alice
stdout OK
gnokey maketx call -pkgpath gno.land/r/test/proxy -func UseUserTeller -args $bob_user_addr -args 100 -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test alice
stdout OK
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$alice_user_addr\")"
stdout '900 int64'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$bob_user_addr\")"
stdout '100 int64'

# A callback crossed from the token realm has a realm, rather than the signing
# EOA, as its previous frame and cannot create a user-relative transfer.
! gnokey maketx call -pkgpath gno.land/r/test/proxy -func CallbackUserTeller -args $bob_user_addr -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test alice
stderr 'user teller requires a direct EOA call'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$alice_user_addr\")"
stdout '900 int64'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$bob_user_addr\")"
stdout '100 int64'

# A non-crossing callback has no fresh realm argument; its captured proxy frame
# is stale after the token crossing and cannot authorize a user transfer.
! gnokey maketx call -pkgpath gno.land/r/test/proxy -func NonCrossingCallbackUserTeller -args $bob_user_addr -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test alice
stderr 'rlm does not match the current crossing frame'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$alice_user_addr\")"
stdout '900 int64'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$bob_user_addr\")"
stdout '100 int64'

# An intermediate realm cannot relay a delegated UserTeller Transfer call.
! gnokey maketx call -pkgpath gno.land/r/test/transfer_midx -func RelayUserTeller -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test alice
stderr 'user teller requires a direct EOA call'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$alice_user_addr\")"
stdout '900 int64'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$bob_user_addr\")"
stdout '100 int64'

# A realm value from the prior frame is stale and cannot transfer Alice's balance.
! gnokey maketx call -pkgpath gno.land/r/test/proxy -func StaleUserTeller -args $bob_user_addr -args 1 -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test alice
stderr 'rlm does not match the current crossing frame'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$alice_user_addr\")"
stdout '900 int64'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$bob_user_addr\")"
stdout '100 int64'

# MsgRun is not a direct MsgCall EOA and cannot transfer Alice's balance.
! gnokey maketx run -gas-fee 1000000ugnot -gas-wanted 20_000_000 -chainid=tendermint_test alice $WORK/run/transfer.gno
stderr 'user teller requires a direct EOA call'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$alice_user_addr\")"
stdout '900 int64'
gnokey query vm/qeval --data "gno.land/r/test/transfertok.BalanceOf(\"$bob_user_addr\")"
stdout '100 int64'

-- transfertok/gnomod.toml --
module = "gno.land/r/test/transfertok"
gno = "0.9"

-- transfertok/transfertok.gno --
package transfertok

import "gno.land/p/demo/tokens/grc20"

var (
	Token *grc20.Token
	adm   *grc20.PrivateLedger
)

func init(cur realm) {
	Token, adm = grc20.NewToken("Transfer Token", "TRF", 4, 0, cur)
}

// Test-only delegation: only this fixture's proxy may obtain the capability.
func Delegate(cur realm) grc20.Teller {
	if !cur.IsCurrent() { panic(grc20.ErrSpoofedRealm) }
	if cur.Previous().PkgPath() != "gno.land/r/test/proxy" { panic("not the delegate") }
	return adm.UserTeller()
}

func Faucet(cur realm) {
	if err := adm.Mint(cur.Previous().Address(), 1_000); err != nil {
		panic(err)
	}
}

func InvokeCallback(cur realm, callback func(cur realm) error) {
	if err := callback(cross(cur)); err != nil {
		panic(err)
	}
}

func InvokeNonCrossingCallback(cur realm, callback func() error) {
	if err := callback(); err != nil {
		panic(err)
	}
}

func BalanceOf(owner address) int64 { return Token.BalanceOf(owner) }

-- proxy/gnomod.toml --
module = "gno.land/r/test/proxy"
gno = "0.9"

-- proxy/proxy.gno --
package proxy

import (
 "gno.land/r/test/transfertok"
 "gno.land/p/demo/tokens/grc20"
)

var userTeller grc20.Teller

func init(cur realm) { userTeller = transfertok.Delegate(cross(cur)) }

func UseUserTeller(cur realm, to address, amount int64) {
	if err := userTeller.Transfer(0, cur, to, amount); err != nil {
		panic(err)
	}
}

func CallbackUserTeller(cur realm, to address) {
	transfertok.InvokeCallback(cross(cur), func(cur realm) error {
		return userTeller.Transfer(0, cur, to, 1)
	})
}

func NonCrossingCallbackUserTeller(cur realm, to address) {
	transfertok.InvokeNonCrossingCallback(cross(cur), func() error {
		return userTeller.Transfer(0, cur, to, 1)
	})
}

func StaleUserTeller(cur realm, to address, amount int64) {
	if err := userTeller.Transfer(0, cur.Previous(), to, amount); err != nil {
		panic(err)
	}
}

-- midx/gnomod.toml --
module = "gno.land/r/test/transfer_midx"
gno = "0.9"

-- midx/midx.gno --
package transfer_midx

import "gno.land/r/test/proxy"

func RelayUserTeller(cur realm) {
	proxy.UseUserTeller(cross(cur), cur.Address(), 1)
}

-- run/transfer.gno --
package main

import "gno.land/r/test/proxy"

func main(cur realm) {
	proxy.UseUserTeller(cross(cur), cur.Address(), 1)
}
