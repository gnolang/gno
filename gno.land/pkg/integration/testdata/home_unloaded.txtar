# A function value stored in realm hv and copied by another realm's append or
# copy is judged by its stored maker, loaded or not: it arrives without one, so
# hv's gate runs it read-only, before and after a restart.

loadpkg gno.land/r/demo/hv $WORK/hv
loadpkg gno.land/r/demo/hz $WORK/hz
gnoland start

gnokey maketx call -pkgpath gno.land/r/demo/hv -func Init -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1

! gnokey maketx call -pkgpath gno.land/r/demo/hz -func Append -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/demo/hv''s code was entered without crossing and is read-only'
! gnokey maketx call -pkgpath gno.land/r/demo/hz -func Copy -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/demo/hv''s code was entered without crossing and is read-only'

gnoland restart

! gnokey maketx call -pkgpath gno.land/r/demo/hz -func Append -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/demo/hv''s code was entered without crossing and is read-only'
! gnokey maketx call -pkgpath gno.land/r/demo/hz -func Copy -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/demo/hv''s code was entered without crossing and is read-only'

gnokey query vm/qeval --data 'gno.land/r/demo/hv.Owner'
stdout 'orig'

-- hv/gnomod.toml --
module = "gno.land/r/demo/hv"
gno = "0.9"

-- hv/hv.gno --
package hv

var (
	Owner = "orig"
	Table []func(string)
)

func set(s string) { Owner = s }

func Init(cur realm) { Table = []func(string){set, set} }

func RunAll(cur realm, fs []func(string)) {
	for _, f := range fs {
		f("ran")
	}
}

-- hz/gnomod.toml --
module = "gno.land/r/demo/hz"
gno = "0.9"

-- hz/hz.gno --
package hz

import "gno.land/r/demo/hv"

func Append(cur realm) {
	t := append([]func(string){}, hv.Table...)
	hv.RunAll(cross(cur), t)
}

func Copy(cur realm) {
	t := make([]func(string), 2)
	copy(t, hv.Table)
	hv.RunAll(cross(cur), t)
}
