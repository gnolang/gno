type T17 struct{ a, b [0]T16 }
type T18 struct{ a, b [0]T17 }
type T19 struct{ a, b [0]T18 }
type T20 struct{ a, b [0]T19 }
type T21 struct{ a, b [0]T20 }
type T22 struct{ a, b [0]T21 }
type T23 struct{ a, b [0]T22 }
type T24 struct{ a, b [0]T23 }
type T25 struct{ a, b [0]T24 }
type T26 struct{ a, b [0]T25 }
type T27 struct{ a, b [0]T26 }
type T28 struct{ a, b [0]T27 }
type T29 struct{ a, b [0]T28 }
type T30 struct{ a, b [0]T29 }
