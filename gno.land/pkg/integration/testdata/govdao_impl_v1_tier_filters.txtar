# After impl/v1 is installed, impl/v0's builders are still allowed. A v0 T1
# membership proposal carries impl/v0's FilterByTier, which impl/v1 must
# enforce exactly as v0 did: only T1 votes. An unknown filter is refused at
# creation rather than read as "anyone votes".

loadpkg gno.land/r/gov/dao
loadpkg gno.land/r/gov/dao/impl/v0
loadpkg gno.land/r/gov/dao/impl/v1
loadpkg gno.land/r/gov/dao/loader/v0
loadpkg gno.land/r/test/setup $WORK/setup

adduser alice
adduser bob
adduser carol

gnoland start

# alice is T1, bob T2, carol T3.
gnokey maketx call -pkgpath gno.land/r/test/setup -func Bootstrap -args $alice_user_addr -args '' -args '' -args $bob_user_addr -args $carol_user_addr -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice
stdout OK!

## Install impl/v1 (proposal 0): unfiltered, every tier votes.
gnokey maketx run -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice $WORK/run/install.gno
stdout OK!
gnokey maketx call -pkgpath gno.land/r/gov/dao -func MustVoteOnProposalSimple -args 0 -args YES -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice
stdout OK!
gnokey maketx call -pkgpath gno.land/r/gov/dao -func MustVoteOnProposalSimple -args 0 -args YES -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test bob
stdout OK!
gnokey maketx call -pkgpath gno.land/r/gov/dao -func MustVoteOnProposalSimple -args 0 -args YES -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test carol
stdout OK!
gnokey maketx call -pkgpath gno.land/r/gov/dao -func ExecuteProposal -args 0 -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice
stdout OK!

## A v0-built T1 membership proposal (proposal 1), created after the install.
gnokey maketx run -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice $WORK/run/add_t1.gno
stdout OK!
gnokey query vm/qrender --data 'gno.land/r/gov/dao:1'
stdout 'New T1 Member Proposal'

# T2 and T3 are refused, so they cannot carry it.
! gnokey maketx call -pkgpath gno.land/r/gov/dao -func MustVoteOnProposalSimple -args 1 -args YES -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test bob
stderr 'member on specified tier is not allowed to vote on this proposal'
! gnokey maketx call -pkgpath gno.land/r/gov/dao -func MustVoteOnProposalSimple -args 1 -args YES -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test carol
stderr 'member on specified tier is not allowed to vote on this proposal'
! gnokey maketx call -pkgpath gno.land/r/gov/dao -func ExecuteProposal -args 1 -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice
stderr 'proposal didn.t reach supermajority yet'

# The T1 vote is what passes it.
gnokey maketx call -pkgpath gno.land/r/gov/dao -func MustVoteOnProposalSimple -args 1 -args YES -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice
stdout OK!
gnokey maketx call -pkgpath gno.land/r/gov/dao -func ExecuteProposal -args 1 -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice
stdout OK!
gnokey query vm/qrender --data 'gno.land/r/gov/dao:1'
stdout 'PROPOSAL HAS BEEN ACCEPTED'

## A proposal with a filter impl/v1 does not know is refused at creation.
! gnokey maketx run -gas-fee 10000000ugnot -gas-wanted 100_000_000 -chainid=tendermint_test alice $WORK/run/unknown_filter.gno
stderr 'unsupported proposal filter'

-- setup/gnomod.toml --
module = "gno.land/r/test/setup"
gno = "0.9"

-- setup/setup.gno --
package setup

import (
	"gno.land/r/gov/dao"
	"gno.land/r/gov/dao/memberstore/v0"
)

// Bootstrap seeds the member set while AllowedDAOs is still empty (the
// genesis window r/gov/dao/loader/v0 leaves open), then locks it to impl/v0.
func Bootstrap(cur realm, t1a, t1b, t1c, t2, t3 address) {
	ms := memberstore.Get(0, cur)
	for _, a := range []address{t1a, t1b, t1c} {
		if a != "" {
			ms.SetMember(memberstore.T1, a, memberstore.NewMember(3))
		}
	}
	if t2 != "" {
		ms.SetMember(memberstore.T2, t2, memberstore.NewMember(2))
	}
	if t3 != "" {
		ms.SetMember(memberstore.T3, t3, memberstore.NewMember(0))
	}
	dao.UpdateImpl(cross(cur), dao.NewUpdateRequest(nil, []string{"gno.land/r/gov/dao/impl/v0"}))
}

type myFilter struct{ OnlyMe bool }

// NewUnknownFilterRequest builds a proposal whose filter no impl knows.
func NewUnknownFilterRequest(cur realm) dao.ProposalRequest {
	e := dao.NewSimpleExecutor(0, cur, func(cur realm) error { return nil }, "does nothing")
	return dao.NewProposalRequestWithFilter("Filtered", "a filter impl/v1 does not know", e, myFilter{OnlyMe: true})
}

-- run/install.gno --
package main

import (
	"gno.land/r/gov/dao"
	impl "gno.land/r/gov/dao/impl/v1"
)

func main(cur realm) {
	dao.MustCreateProposal(cross(cur), impl.NewInstallRequest(cross(cur), "install impl/v1", impl.NewLaw(66.66)))
}

-- run/add_t1.gno --
package main

import (
	"gno.land/r/gov/dao"
	implv0 "gno.land/r/gov/dao/impl/v0"
)

func main(cur realm) {
	req := implv0.NewAddMemberRequest(cross(cur), address("g1rfznvu6qfa0sc76cplk5wpqexvefqccjunady0"), "T1", "a portfolio")
	dao.MustCreateProposal(cross(cur), req)
}

-- run/unknown_filter.gno --
package main

import (
	"gno.land/r/gov/dao"
	"gno.land/r/test/setup"
)

func main(cur realm) {
	dao.MustCreateProposal(cross(cur), setup.NewUnknownFilterRequest(cross(cur)))
}
