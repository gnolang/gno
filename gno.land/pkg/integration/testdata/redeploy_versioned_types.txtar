-- v2_iface_changed/gnomod.toml --
module = "gno.land/r/demo/shapes"
gno = "0.9"
private = true
version = 2

-- v2_iface_changed/shapes.gno --
package shapes

type Entry struct {
	Name string
	N    int
}

type Kind int

type Store interface {
	Get() int
	Set(int)
}

var (
	counter int
	entries []*Entry
	kind    Kind
)

func Tag() string { return "v2" }

-- v2_var_to_const/gnomod.toml --
module = "gno.land/r/demo/shapes"
gno = "0.9"
private = true
version = 2

-- v2_var_to_const/shapes.gno --
package shapes

type Entry struct {
	Name string
	N    int
}

type Kind int

type Store interface{ Get() int }

const counter = 0

var (
	entries []*Entry
	kind    Kind
)

func Tag() string { return "v2" }

-- v2_mixed_decl/gnomod.toml --
module = "gno.land/r/demo/shapes"
gno = "0.9"
private = true
version = 2

-- v2_mixed_decl/shapes.gno --
package shapes

type Entry struct {
	Name string
	N    int
}

type Kind int

type Store interface{ Get() int }

var counter, hits int

var (
	entries []*Entry
	kind    Kind
)

func Tag() string { return "v2" }

-- v2_ok/gnomod.toml --
module = "gno.land/r/demo/shapes"
gno = "0.9"
private = true
version = 2

-- v2_ok/shapes.gno --
package shapes

type Entry struct {
	Name string
	N    int
}

// Describe changed its body; Old is gone: a private realm owes importers nothing.
func (e *Entry) Describe() string { return e.Name + " v2" }

type Kind int

type Store interface{ Get() int }

type Note string // new type

var (
	counter = 100 // carried: the initializer is skipped
	entries []*Entry
	kind    Kind
	hits    int    // new: starts at zero
	log     string // new
)

func init()    { log += "init" } // does not run on an upgrade
func migrate() { log += "a" }
func migrate() { log += "b" }

func Add(cur realm, name string) {
	counter++
	hits++
	entries = append(entries, &Entry{Name: name, N: counter})
}

func Count() int       { return counter }
func Hits() int        { return hits }
func Log() string      { return log }
func Describe() string { return entries[len(entries)-1].Describe() }
func Tag() string      { return "v2" }

-- v3_unversioned/gnomod.toml --
module = "gno.land/r/demo/shapes"
gno = "0.9"
private = true

-- v3_unversioned/shapes.gno --
package shapes

func Tag() string { return "v3" }
