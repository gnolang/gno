# A realm's copy of cbvictim's Pair (an all-exported unnamed struct) is its
# own: it changes a field in its own state. R2a makes the function read-only
# once it is stored, so Change runs it first and Rerun writes nothing; the
# copied function still writes nothing in cbvictim.

loadpkg gno.land/r/tests/vm/cbvictim
loadpkg gno.land/r/test/fvown $WORK/fvown
gnoland start

gnokey maketx call -pkgpath gno.land/r/test/fvown -func Take -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
gnokey maketx call -pkgpath gno.land/r/test/fvown -func Change -args new -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
gnokey query vm/qeval --data 'gno.land/r/test/fvown.Read()'
stdout 'new'
! gnokey maketx call -pkgpath gno.land/r/test/fvown -func Rerun -args again -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/test/fvown''s code is read-only here: a function value writes only in the crossing call that made it'
gnokey query vm/qeval --data 'gno.land/r/test/fvown.Read()'
stdout 'new'

gnoland restart

! gnokey maketx call -pkgpath gno.land/r/test/fvown -func Rerun -args later -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'gno.land/r/test/fvown''s code is read-only here: a function value writes only in the crossing call that made it'
gnokey query vm/qeval --data 'gno.land/r/test/fvown.Read()'
stdout 'new'

gnokey maketx call -pkgpath gno.land/r/test/fvown -func Change -args after -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
gnokey query vm/qeval --data 'gno.land/r/test/fvown.Read()'
stdout 'after'

! gnokey maketx call -pkgpath gno.land/r/test/fvown -func CallOrig -gas-fee 1000000ugnot -gas-wanted 10_000_000 -chainid=tendermint_test test1
stderr 'cbvictim''s code was entered without crossing and is read-only'
gnokey query vm/qeval --data 'gno.land/r/tests/vm/cbvictim.Owner'
stdout 'victim'

-- fvown/gnomod.toml --
module = "gno.land/r/test/fvown"
gno = "0.9"

-- fvown/fvown.gno --
package fvown

import "gno.land/r/tests/vm/cbvictim"

var (
	kept  cbvictim.Pair
	orig  cbvictim.Pair
	Local string
)

// Take copies cbvictim's exempt unnamed struct into this realm's state.
func Take(cur realm) {
	kept = cbvictim.P.Inner
	orig = cbvictim.P.Inner
}

// Change writes this realm's own copy of the struct.
func Change(cur realm, s string) {
	f := func(s string) { Local = s }
	f(s)
	kept.F = f
}

// Rerun calls the stored function without setting it again.
func Rerun(cur realm, s string) { kept.F(s) }

func Read() string { return Local }

// CallOrig runs the copied function; it must not write cbvictim.
func CallOrig(cur realm) { orig.F("evil") }
