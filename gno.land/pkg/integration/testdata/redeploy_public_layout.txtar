-- board_v2_ok/board.gno --
package board

import "strings"

type Post struct{ Text string }

func (p *Post) Body() string  { return strings.ToUpper(p.Text) } // body changed
func (p *Post) Len() int       { return len(p.Text) }
func (p *Post) Lower() string { return strings.ToLower(p.Text) } // appended

const Limit = 10

var (
	posts []*Post
	hits  int
)

func Publish(cur realm, text string) *Post {
	p := &Post{Text: text}
	posts = append(posts, p)
	views++
	return p
}

func Count() int  { return len(posts) }
func Unused() int { return hits }
func Tag() string { return "v2" }

// Appended below every v1 name. init() is gone; migrate and the blank func
// are reserved after every other name, so nothing above moved.
type Draft struct{ Text string }

var views int

func Last() string { return posts[len(posts)-1].Body() }
func Views() int   { return views }

func migrate() { views = len(posts) }
func _()       {}

-- reader_v1/gnomod.toml --
module = "gno.land/r/demo/reader"
gno = "0.9"
version = 1

[upgrade]
authority = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"

-- reader_v1/reader.gno --
package reader

import (
	"strconv"

	"gno.land/r/demo/board"
)

var first *board.Post

func Publish(cur realm, text string) {
	p := board.Publish(cross(cur), text)
	if first == nil {
		first = p
	}
}

func Summary() string {
	return first.Body() + "/" + strconv.Itoa(first.Len()) + "/" +
		strconv.Itoa(board.Count()) + "/" + strconv.Itoa(board.Limit)
}

