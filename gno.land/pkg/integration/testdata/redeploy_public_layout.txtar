# What a public redeploy may change about its layout, and what it refuses.
#
# Importers compile `pkg.X` to a slot in the package block and `v.M()` to an
# index in the type's method list, so a public realm may only append: no
# declaration or method may be removed, moved or retyped, whether or not any
# importer uses it. init, migrate and blank funcs are reserved after every
# other name, so adding or dropping them moves nothing. An immutable realm
# cannot gain an authority later, and an upgradeable one cannot turn private.

gnoland start

gnokey maketx addpkg -pkgdir $WORK/board_v1 -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stdout OK!
gnokey maketx addpkg -pkgdir $WORK/reader_v1 -pkgpath gno.land/r/demo/reader -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stdout OK!
gnokey maketx call -pkgpath gno.land/r/demo/reader -func Publish -args hello -gas-fee 1000000ugnot -gas-wanted 10000000 -chainid=tendermint_test test1
stdout OK!
gnokey query vm/qeval --data 'gno.land/r/demo/reader.Summary()'
stdout '"hello/5/1/10"'

# Refused: a function is dropped. Unused by the reader, but some importer may
# hold its slot.
! gnokey maketx addpkg -pkgdir $WORK/board_v2_func_removed -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'upgrade: declaration Unused moved or was removed'

# Refused: a global is dropped. A private realm may; a public one may not.
! gnokey maketx addpkg -pkgdir $WORK/board_v2_var_removed -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'upgrade: declaration hits moved or was removed'

# Refused: a function changes signature in place.
! gnokey maketx addpkg -pkgdir $WORK/board_v2_func_retyped -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'upgrade: declaration Count changed type from'

# Refused: a constant changes type.
! gnokey maketx addpkg -pkgdir $WORK/board_v2_const_retyped -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'upgrade: declaration Limit changed type from'

# Refused: a method is dropped.
! gnokey maketx addpkg -pkgdir $WORK/board_v2_method_removed -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'upgrade: method Len moved or was removed'

# Refused: two methods swap places.
! gnokey maketx addpkg -pkgdir $WORK/board_v2_method_moved -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'upgrade: method Body moved or was removed'

# Refused: a method changes signature.
! gnokey maketx addpkg -pkgdir $WORK/board_v2_method_retyped -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'upgrade: method Body changed type from'

# Refused: an upgradeable realm cannot turn private.
! gnokey maketx addpkg -pkgdir $WORK/board_v2_private -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'an upgradeable package cannot become private'

# Every refusal left version 1 serving the reader.
gnokey query vm/qeval --data 'gno.land/r/demo/reader.Summary()'
stdout '"hello/5/1/10"'
gnokey query vm/qeval --data 'gno.land/r/demo/board.Tag()'
stdout '"v1"'

# Permitted: append a method, a function, a global and a type; drop init();
# add migrate() and a blank func. No slot the reader compiled against moves.
gnokey maketx addpkg -pkgdir $WORK/board_v2_ok -pkgpath gno.land/r/demo/board -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stdout OK!
gnokey query vm/qeval --data 'gno.land/r/demo/board.Tag()'
stdout '"v2"'
gnokey query vm/qeval --data 'gno.land/r/demo/board.Views()'
stdout '1 int'
# The reader, compiled against v1, still resolves every selector; the post it
# persisted answers with v2's Body.
gnokey query vm/qeval --data 'gno.land/r/demo/reader.Summary()'
stdout '"HELLO/5/1/10"'
gnokey maketx call -pkgpath gno.land/r/demo/reader -func Publish -args again -gas-fee 1000000ugnot -gas-wanted 10000000 -chainid=tendermint_test test1
stdout OK!
gnokey query vm/qeval --data 'gno.land/r/demo/reader.Summary()'
stdout '"HELLO/5/2/10"'

# The reader redeploys against v2 to use what v2 appended.
gnokey maketx addpkg -pkgdir $WORK/reader_v2 -pkgpath gno.land/r/demo/reader -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stdout OK!
gnokey query vm/qeval --data 'gno.land/r/demo/reader.Summary()'
stdout '"HELLO/5/2/10 last=AGAIN"'

gnoland restart
stdout 'node restarted successfully'
gnokey query vm/qeval --data 'gno.land/r/demo/reader.Summary()'
stdout '"HELLO/5/2/10 last=AGAIN"'

# An immutable realm cannot gain an authority later: the path is permanent.
gnokey maketx addpkg -pkgdir $WORK/fixed_v1 -pkgpath gno.land/r/demo/fixed -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stdout OK!
! gnokey maketx addpkg -pkgdir $WORK/fixed_v2 -pkgpath gno.land/r/demo/fixed -gas-fee 1000000ugnot -gas-wanted 100000000 -chainid=tendermint_test test1
stderr 'package already exists: gno.land/r/demo/fixed'

-- board_v1/gnomod.toml --
module = "gno.land/r/demo/board"
gno = "0.9"
version = 1

[upgrade]
authority = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"

-- board_v1/board.gno --
package board

type Post struct{ Text string }

func (p *Post) Body() string { return p.Text }
func (p *Post) Len() int      { return len(p.Text) }

const Limit = 10

var (
	posts []*Post
	hits  int
)

func Publish(cur realm, text string) *Post {
	p := &Post{Text: text}
	posts = append(posts, p)
	return p
}

func Count() int  { return len(posts) }
func Unused() int { return hits }
func Tag() string { return "v1" }

func init() {}

