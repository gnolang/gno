# `var a, b T = f()` converts each result to T with the checks `var a T = x`
# gets. A realm cannot relabel another realm's stored slice to a /p/ type
# with a mutator, and an ordinary named<->unnamed declaration still converts.
# A result whose declared type is already T is not converted, as in `a, b :=`.

loadpkg gno.land/r/test/members $WORK/members
loadpkg gno.land/r/test/vault $WORK/vault

gnoland start

gnokey maketx addpkg -pkgdir $WORK/pun -pkgpath gno.land/p/test/pun -gas-fee 10000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stdout OK!

gnokey maketx addpkg -pkgdir $WORK/attacker -pkgpath gno.land/r/test/attacker -gas-fee 10000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stdout OK!

# The explicit conversion is refused by the readonly check.
! gnokey maketx call -pkgpath gno.land/r/test/attacker -func Explicit -gas-fee 1000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stderr 'illegal conversion of readonly or externally stored value'

# So is the same conversion through a multi-value declaration.
! gnokey maketx call -pkgpath gno.land/r/test/attacker -func Attack -gas-fee 1000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stderr 'illegal conversion of readonly or externally stored value'

gnokey query vm/qeval --data 'gno.land/r/test/members.First()'
stdout 'data: \("alice" string\)'

# A declaration that converts a result the realm owns still runs.
gnokey query vm/qeval --data 'gno.land/r/test/attacker.Kinds()'
stdout 'data: \("map map" string\)'

gnokey maketx addpkg -pkgdir $WORK/reader -pkgpath gno.land/r/test/reader -gas-fee 10000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stdout OK!

# vault.Pair is declared to return map[string]int, the declaration's own type,
# so the declaration takes vault's stored maps as `a, b :=` does. Its
# `return two()` may leave vault.M as their run-time type: converting on that
# would refuse an honest read of another realm's values.
gnokey maketx call -pkgpath gno.land/r/test/reader -func Define -gas-fee 1000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stdout '\(3 int\)'

gnokey maketx call -pkgpath gno.land/r/test/reader -func Decl -gas-fee 1000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stdout '\(3 int\)'

# Holding vault's own type by value outside vault is refused at type check (R3).
! gnokey maketx addpkg -pkgdir $WORK/minter -pkgpath gno.land/r/test/minter -gas-fee 10000000ugnot -gas-wanted 20000000 -chainid=tendermint_test test1
stderr 'cannot hold a value of gno.land/r/test/vault.Tok outside its realm \(use a pointer\)'

-- members/gnomod.toml --
module = "gno.land/r/test/members"
gno = "0.9"

-- members/members.gno --
package members

var list = []string{"alice", "bob"}

// List hands out the stored slice; callers can read it but cannot write it.
func List() []string { return list }

func First() string { return list[0] }

-- pun/gnomod.toml --
module = "gno.land/p/test/pun"
gno = "0.9"

-- pun/pun.gno --
package pun

type L []string

func (l L) Set(i int, v string) { l[i] = v }

-- attacker/gnomod.toml --
module = "gno.land/r/test/attacker"
gno = "0.9"

-- attacker/attacker.gno --
package attacker

import (
	"gno.land/p/test/pun"
	"gno.land/r/test/members"
)

func pair() ([]string, []string) { return members.List(), nil }

func Explicit(cur realm) {
	pun.L(members.List()).Set(0, "mallory")
}

func Attack(cur realm) {
	var l, _ pun.L = pair()
	l.Set(0, "mallory")
}

type NamedMap map[string]int

func two() (NamedMap, NamedMap) { return NamedMap{"a": 1}, NamedMap{"b": 2} }

func kind(x any) string {
	switch x.(type) {
	case NamedMap:
		return "NamedMap"
	case map[string]int:
		return "map"
	}
	return "other"
}

func Kinds() string {
	var a, b map[string]int = two()
	return kind(a) + " " + kind(b)
}

-- vault/gnomod.toml --
module = "gno.land/r/test/vault"
gno = "0.9"

-- vault/vault.gno --
package vault

type M map[string]int

var a = M{"x": 1}
var b = M{"y": 2}

func two() (M, M) { return a, b }

func Pair(cur realm) (map[string]int, map[string]int) { return two() }

type Tok struct{ Id string }

func mk() (struct{ Id string }, struct{ Id string }) {
	return struct{ Id string }{"a"}, struct{ Id string }{"b"}
}

func Mint(cur realm) (Tok, Tok) { return mk() }

-- reader/gnomod.toml --
module = "gno.land/r/test/reader"
gno = "0.9"

-- reader/reader.gno --
package reader

import "gno.land/r/test/vault"

func Define(cur realm) int {
	a, b := vault.Pair(cross(cur))
	return a["x"] + b["y"]
}

func Decl(cur realm) int {
	var a, b map[string]int = vault.Pair(cross(cur))
	return a["x"] + b["y"]
}

-- minter/gnomod.toml --
module = "gno.land/r/test/minter"
gno = "0.9"

-- minter/minter.gno --
package minter

import "gno.land/r/test/vault"

func Mint(cur realm) string {
	var a, b vault.Tok = vault.Mint(cross(cur))
	return a.Id + b.Id
}
