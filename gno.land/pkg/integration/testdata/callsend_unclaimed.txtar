# A PayCall forward can only be read by the payee when entered by the payer,
# and the message fails if it is never read. So a router that pays the vault
# and then reaches it through a third realm, or never calls it at all, gets an
# error and its user is refunded — the vault never attributes the coins to the
# wrong realm.
loadpkg gno.land/r/test/vault $WORK/vault
loadpkg gno.land/r/test/third $WORK/third
loadpkg gno.land/r/test/router $WORK/router

adduser user1
gnoland start

# Pay the vault, then call it through an unrelated third realm.
! gnokey maketx call -pkgpath gno.land/r/test/router -func Misroute -send 5000ugnot -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test user1
stderr '5000ugnot forwarded by gno.land/r/test/router to gno.land/r/test/vault: never read by the payee'

# Pay the vault and never call it.
! gnokey maketx call -pkgpath gno.land/r/test/router -func Forget -send 5000ugnot -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test user1
stderr 'forwarded by gno.land/r/test/router to gno.land/r/test/vault: never read by the payee'

# Nothing landed anywhere: both messages were discarded whole.
gnokey query vm/qeval --data "gno.land/r/test/vault.CreditedTo(\"gno.land/r/test/third\")"
stdout '0 int64'

gnokey query vm/qeval --data "gno.land/r/test/vault.Bal()"
stdout '0 int64'

# The correct shape — pay, then cross into the payee — attributes to the router.
gnokey maketx call -pkgpath gno.land/r/test/router -func Route -send 5000ugnot -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test user1
stdout 'OK!'

gnokey query vm/qeval --data "gno.land/r/test/vault.CreditedTo(\"gno.land/r/test/router\")"
stdout '5000 int64'

# A forward to a non-realm path is refused before any coins move.
! gnokey maketx call -pkgpath gno.land/r/test/router -func PayPure -send 5000ugnot -gas-fee 2000000ugnot -gas-wanted 20000000 -chainid=tendermint_test user1
stderr 'is not a realm path'

-- vault/gnomod.toml --
module = "gno.land/r/test/vault"
gno = "0.9"

-- vault/vault.gno --
package vault

import (
	"chain"
	"chain/banker"
)

var credited = map[string]int64{}

func Deposit(cur realm) {
	credited[cur.Previous().PkgPath()] += banker.CallSend().AmountOf("ugnot")
}

func CreditedTo(p string) int64 { return credited[p] }

func Bal() int64 {
	return banker.NewReadonlyBanker().GetCoin(chain.PackageAddress("gno.land/r/test/vault"), "ugnot")
}

-- third/gnomod.toml --
module = "gno.land/r/test/third"
gno = "0.9"

-- third/third.gno --
package third

import "gno.land/r/test/vault"

func Go(cur realm) { vault.Deposit(cross(cur)) }

-- router/gnomod.toml --
module = "gno.land/r/test/router"
gno = "0.9"

-- router/router.gno --
package router

import (
	"chain"
	"chain/banker"

	"gno.land/r/test/third"
	"gno.land/r/test/vault"
)

func pay(cur realm, to string) {
	got := banker.CallSend().AmountOf("ugnot")
	banker.PayCall(to, cur, chain.Coins{{"ugnot", got}})
}

func Route(cur realm) {
	pay(cur, "gno.land/r/test/vault")
	vault.Deposit(cross(cur))
}

func Misroute(cur realm) {
	pay(cur, "gno.land/r/test/vault")
	third.Go(cross(cur))
}

func Forget(cur realm) {
	pay(cur, "gno.land/r/test/vault")
}

func PayPure(cur realm) {
	pay(cur, "gno.land/p/test/lib")
}
