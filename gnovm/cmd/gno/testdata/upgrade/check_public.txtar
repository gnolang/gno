# gno upgrade check: a public realm may only append.

gno upgrade check v1 v2
! stderr .

! gno upgrade check v1 v2_moved
stderr 'upgrade: declaration Receipt moved or was removed; importers compiled against the declaration order, so a public realm may only append'

! gno upgrade check v1 v2_new_file_first
stderr 'upgrade: declaration Receipt moved or was removed'

! gno upgrade check v1 v2_method_moved
stderr 'upgrade: method String moved or was removed'

! gno upgrade check v1 v2_private
stderr 'an upgradeable package cannot become private'

-- v1/gnomod.toml --
module = "gno.land/r/demo/vault"
gno = "0.9"
version = 1

[upgrade]
authority = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"

-- v1/vault.gno --
package vault

type Receipt struct{ Amount int64 }

func (r *Receipt) String() string { return "v1" }

var total int64

func Deposit(cur realm, n int64) *Receipt { total += n; return &Receipt{Amount: n} }

-- v2/gnomod.toml --
module = "gno.land/r/demo/vault"
gno = "0.9"
version = 2

[upgrade]
authority = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"

-- v2/vault.gno --
package vault

type Receipt struct{ Amount int64 }

func (r *Receipt) String() string { return "v2" }
func (r *Receipt) Doubled() int64 { return r.Amount * 2 } // appended

var total int64

func Deposit(cur realm, n int64) *Receipt { total += n; count++; return &Receipt{Amount: n} }

-- v2/z_count.gno --
package vault

var count int // appended, in a file that sorts last

func migrate(from int) { count = 1 }

func Count() int { return count }

-- v2_moved/gnomod.toml --
module = "gno.land/r/demo/vault"
gno = "0.9"
version = 2

[upgrade]
authority = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"

-- v2_moved/vault.gno --
package vault

var total int64 // moved ahead of Receipt

type Receipt struct{ Amount int64 }

func (r *Receipt) String() string { return "v2" }

func Deposit(cur realm, n int64) *Receipt { total += n; return &Receipt{Amount: n} }

-- v2_new_file_first/gnomod.toml --
module = "gno.land/r/demo/vault"
gno = "0.9"
version = 2

[upgrade]
authority = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"

-- v2_new_file_first/a_count.gno --
package vault

var count int // sorts before vault.gno, so it takes the first slot

-- v2_new_file_first/vault.gno --
package vault

type Receipt struct{ Amount int64 }

func (r *Receipt) String() string { return "v2" }

var total int64

func Deposit(cur realm, n int64) *Receipt { total += n; return &Receipt{Amount: n} }

-- v2_method_moved/gnomod.toml --
module = "gno.land/r/demo/vault"
gno = "0.9"
version = 2

[upgrade]
authority = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"

-- v2_method_moved/vault.gno --
package vault

type Receipt struct{ Amount int64 }

func (r *Receipt) Doubled() int64 { return r.Amount * 2 } // inserted before String
func (r *Receipt) String() string { return "v2" }

var total int64

func Deposit(cur realm, n int64) *Receipt { total += n; return &Receipt{Amount: n} }

-- v2_private/gnomod.toml --
module = "gno.land/r/demo/vault"
gno = "0.9"
private = true
version = 2

-- v2_private/vault.gno --
package vault

type Receipt struct{ Amount int64 }

func (r *Receipt) String() string { return "v2" }

var total int64

func Deposit(cur realm, n int64) *Receipt { total += n; return &Receipt{Amount: n} }
