# Packages using int256/uint256, which Go lacks, are transpiled but not built
# as Go, nor are the packages importing them; other packages are transpiled
# and built as before, byte for byte.
env GNOROOT=$WORK

gno tool transpile -v -gobuild ./examples
! stdout .+

# The two-file case: the 256-bit type in a.gno, its use in b.gno.
stderr 'examples/gno.land/r/test/twofile \[build skipped: uses int256/uint256, which Go lacks \(a.gno\)\]'
exists examples/gno.land/r/test/twofile/a.gno.gen.go
exists examples/gno.land/r/test/twofile/b.gno.gen.go

# A three-package chain: base uses uint256, mid imports base, top imports mid.
stderr 'examples/gno.land/r/test/base \[build skipped: uses int256/uint256, which Go lacks \(base.gno\)\]'
stderr 'examples/gno.land/r/test/mid \[build skipped: imports gno.land/r/test/base, which is not built as Go\]'
stderr 'examples/gno.land/r/test/top \[build skipped: imports gno.land/r/test/mid, which is not built as Go\]'

# A promoted method, an init dependency and a mixed declaration block are
# skipped whole: no part of them is built.
stderr 'examples/gno.land/r/test/promoted \[build skipped: uses int256/uint256, which Go lacks \(promoted.gno\)\]'
stderr 'examples/gno.land/r/test/initdep \[build skipped: uses int256/uint256, which Go lacks \(initdep.gno\)\]'
stderr 'examples/gno.land/r/test/mixed \[build skipped: uses int256/uint256, which Go lacks \(mixed.gno\)\]'

# No 256-bit type: a field named uint256 and a local named like an import
# are ordinary Go, built and transpiled unchanged.
stderr 'examples/gno.land/r/test/plain \[build\]'
! stderr 'examples/gno.land/r/test/plain \[build skipped'
cmp examples/gno.land/r/test/plain/plain.gno.gen.go plain.gno.gen.go.golden

-- examples/gno.land/r/test/twofile/gnomod.toml --
module = "gno.land/r/test/twofile"
gno = "0.9"
-- examples/gno.land/r/test/twofile/a.gno --
package twofile

type Amount struct{ v uint256 }
-- examples/gno.land/r/test/twofile/b.gno --
package twofile

func Zero() Amount { return Amount{} }

-- examples/gno.land/r/test/base/gnomod.toml --
module = "gno.land/r/test/base"
gno = "0.9"
-- examples/gno.land/r/test/base/base.gno --
package base

type Balance struct{ V uint256 }

func New() Balance { return Balance{} }
-- examples/gno.land/r/test/mid/gnomod.toml --
module = "gno.land/r/test/mid"
gno = "0.9"
-- examples/gno.land/r/test/mid/mid.gno --
package mid

import "gno.land/r/test/base"

func Get() base.Balance { return base.New() }
-- examples/gno.land/r/test/top/gnomod.toml --
module = "gno.land/r/test/top"
gno = "0.9"
-- examples/gno.land/r/test/top/top.gno --
package top

import "gno.land/r/test/mid"

func Use() { _ = mid.Get() }

-- examples/gno.land/r/test/promoted/gnomod.toml --
module = "gno.land/r/test/promoted"
gno = "0.9"
-- examples/gno.land/r/test/promoted/promoted.gno --
package promoted

type Base struct{}

func (Base) M() int { return 1 }

type T struct{ Base }

func (T) M() int { return int(uint256(2)) }

func Keep() int { return T{}.M() }

-- examples/gno.land/r/test/initdep/gnomod.toml --
module = "gno.land/r/test/initdep"
gno = "0.9"
-- examples/gno.land/r/test/initdep/initdep.gno --
package initdep

var Ready bool

func init() { Ready = uint256(1) == 1 }

func Keep() bool { return Ready }

-- examples/gno.land/r/test/mixed/gnomod.toml --
module = "gno.land/r/test/mixed"
gno = "0.9"
-- examples/gno.land/r/test/mixed/mixed.gno --
package mixed

type (
	Amount  uint256
	Counter int
)

func Next(c Counter) Counter { return c + 1 }

-- examples/gno.land/r/test/plain/gnomod.toml --
module = "gno.land/r/test/plain"
gno = "0.9"
-- examples/gno.land/r/test/plain/plain.gno --
package plain

type S struct{ uint256 int }

func Get(s S) int {
	strconv := struct{ N int }{s.uint256}
	return strconv.N
}
-- plain.gno.gen.go.golden --
// Code generated by github.com/gnolang/gno. DO NOT EDIT.

//go:build gno

//line plain.gno:1:1
package plain

type S struct{ uint256 int }

func Get(s S) int {
	strconv := struct{ N int }{s.uint256}
	return strconv.N
}
