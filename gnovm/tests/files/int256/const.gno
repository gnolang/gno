package main

import "math"

// Constants at the boundaries of each type.
const (
	maxU uint256 = 1<<256 - 1
	maxI int256  = 1<<255 - 1
	minI int256  = -1 << 255
	hex  uint256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
	big          = 1 << 200 // untyped
)

func main() {
	println(maxU, maxI, minI, hex == maxU)
	println(maxU == math.MaxUint256, maxI == math.MaxInt256, minI == math.MinInt256)

	// Constant folding, with exact results that fit the type.
	const a = maxU / 2
	const b = minI + maxI
	const c = maxU >> 255
	const d = -maxI
	const e = int256(big) * 4
	const f = ^uint256(0)
	const g = uint256(1) << 255
	println(a, b, c, d, e, f == maxU, g)

	// Untyped constants and float constants that are whole numbers convert.
	var u uint256 = big
	var v uint256 = 1e70
	var w int256 = -big
	println(u, v, w)

	// Typed constants of other kinds convert to 256 bits exactly.
	const m64 int64 = math.MinInt64
	println(int256(m64), uint256(uint64(math.MaxUint64)))
}

