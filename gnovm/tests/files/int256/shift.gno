package main

func main() {
	var one uint256 = 1
	var neg int256 = -1 << 200
	for _, n := range []uint{0, 1, 64, 128, 255, 256, 257, 1 << 63} {
		println(n, one<<n, one<<n>>n, neg>>n, neg<<n)
	}

	// The shift count may itself be a 256-bit integer; a huge count is not
	// truncated to its low bits.
	var big uint256 = 1<<64 + 1
	println(one<<big, neg>>big)
	var s int256 = 3
	println(one<<s, neg>>s)

	// Shift assignments.
	x := uint256(1)
	x <<= 255
	println(x)
	x >>= big
	println(x)
	y := int256(-8)
	y >>= s
	println(y)
}

