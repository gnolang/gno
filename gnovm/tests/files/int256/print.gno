package main

import (
	"fmt"
	"math"
)

type Amount uint256

func main() {
	var u uint256 = math.MaxUint256
	var i int256 = math.MinInt256
	var z int256
	print(u, " ", i, " ", z, "\n")
	println(u, i, z, Amount(42))

	fmt.Printf("%d %v %x %X %b\n", uint256(255), int256(-255), uint256(255), uint256(255), int256(-5))
	fmt.Printf("%#x %o %O %+d % d\n", uint256(255), uint256(8), uint256(8), int256(5), int256(5))
	fmt.Printf("[%8d] [%-8d] [%08d] [%.4d]\n", int256(-42), uint256(42), int256(-42), uint256(7))
	fmt.Printf("%v %d %x\n", u, i, i)
	fmt.Printf("%v %v\n", Amount(7), []int256{-1, 0, 1})
	fmt.Println(u, i, struct{ A uint256 }{3})
	fmt.Printf("%T %T %T\n", u, i, Amount(1))
}

