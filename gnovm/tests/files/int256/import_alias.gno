package main

import u256 "gno.land/p/onbloc/uint256/v0"

// The library type and the builtin coexist under different names.
func main() {
	lib := u256.MustFromDecimal("115792089237316195423570985008687907853269984665640564039457584007913129639935")
	var native uint256 = 1<<256 - 1
	println(lib.Dec(), native, lib.Dec() == "115792089237316195423570985008687907853269984665640564039457584007913129639935")
}

// Output:
// 115792089237316195423570985008687907853269984665640564039457584007913129639935 115792089237316195423570985008687907853269984665640564039457584007913129639935 true
