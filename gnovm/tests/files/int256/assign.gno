package main

// Untyped constants are checked against the exact range of the target in
// every context.
type S struct {
	U uint256
	I int256
}

func f(u uint256, i int256) (uint256, int256) { return u, i }

func g() int256 { return -1 << 255 }

func main() {
	u, i := f(1<<256-1, -1<<255)
	println(u, i, g())
	s := S{U: 1 << 255, I: 1<<255 - 1}
	println(s.U, s.I)
	a := [2]uint256{1 << 200, 1<<256 - 1}
	println(a[0], a[1])
	var x uint256
	x += 1<<256 - 1
	println(x)
	switch x {
	case 1<<256 - 1:
		println("max")
	}
	println(x == 1<<256-1, i < 1<<200)
}

