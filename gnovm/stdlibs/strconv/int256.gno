package strconv

// Conversions for the 256-bit integer types int256 and uint256. They have no
// counterpart in Go; they follow FormatInt/FormatUint and ParseInt/ParseUint,
// without the bitSize argument (the size is always 256).

const maxUint256 = 1<<256 - 1

// The int256 limits. An int256 constant must fit an int64, so they are
// variables converted from uint256 bits.
var (
	signBit256 uint256 = 1 << 255
	maxInt256          = int256(signBit256 - 1)
	minInt256          = int256(signBit256)
)

// FormatUint256 returns the string representation of u in the given base,
// for 2 <= base <= 36. The result uses the lower-case letters 'a' to 'z'
// for digit values >= 10.
func FormatUint256(u uint256, base int) string {
	return string(AppendUint256(nil, u, base))
}

// FormatInt256 returns the string representation of i in the given base,
// for 2 <= base <= 36. The result uses the lower-case letters 'a' to 'z'
// for digit values >= 10.
func FormatInt256(i int256, base int) string {
	return string(AppendInt256(nil, i, base))
}

// AppendUint256 appends the string form of u, as generated by
// FormatUint256, to dst and returns the extended buffer.
func AppendUint256(dst []byte, u uint256, base int) []byte {
	return formatBits256(dst, u, base, false)
}

// AppendInt256 appends the string form of i, as generated by FormatInt256,
// to dst and returns the extended buffer.
func AppendInt256(dst []byte, i int256, base int) []byte {
	if i < 0 {
		// -i wraps for the smallest int256, whose magnitude is still
		// right as a uint256.
		return formatBits256(dst, uint256(-i), base, true)
	}
	return formatBits256(dst, uint256(i), base, false)
}

// formatBits256 appends u in the given base to dst. It peels off the largest
// power of the base that fits a uint64 at a time, so that a 256-bit number
// costs a handful of 256-bit divisions, and formats each chunk with the
// 64-bit formatBits.
func formatBits256(dst []byte, u uint256, base int, neg bool) []byte {
	if base < 2 || base > len(digits) {
		panic("strconv: illegal AppendInt/FormatInt base")
	}
	if neg {
		dst = append(dst, '-')
	}
	if u <= maxUint64 {
		dst, _ = formatBits(dst, uint64(u), base, false, true)
		return dst
	}

	// chunk = base^width, the largest power of base that fits a uint64.
	b := uint64(base)
	chunk, width := b, 1
	for chunk <= maxUint64/b {
		chunk *= b
		width++
	}

	// Split u into chunks, least significant first; at most 256 bits
	// over at least 63 bits per chunk.
	var parts [5]uint64
	n := 0
	for u > maxUint64 {
		q := u / uint256(chunk)
		parts[n] = uint64(u - q*uint256(chunk))
		n++
		u = q
	}
	dst, _ = formatBits(dst, uint64(u), base, false, true)
	var pad [64]byte
	for n > 0 {
		n--
		var s []byte
		s, _ = formatBits(pad[:0], parts[n], base, false, true)
		for i := len(s); i < width; i++ {
			dst = append(dst, '0')
		}
		dst = append(dst, s...)
	}
	return dst
}

// ParseUint256 is like ParseInt256 but for unsigned numbers.
//
// A sign prefix is not permitted.
func ParseUint256(s string, base int) (uint256, error) {
	const fnParseUint256 = "ParseUint256"

	if s == "" {
		return 0, syntaxError(fnParseUint256, s)
	}

	base0 := base == 0

	s0 := s
	switch {
	case 2 <= base && base <= 36:
		// valid base; nothing to do

	case base == 0:
		// Look for octal, hex prefix.
		base = 10
		if s[0] == '0' {
			switch {
			case len(s) >= 3 && lower(s[1]) == 'b':
				base = 2
				s = s[2:]
			case len(s) >= 3 && lower(s[1]) == 'o':
				base = 8
				s = s[2:]
			case len(s) >= 3 && lower(s[1]) == 'x':
				base = 16
				s = s[2:]
			default:
				base = 8
				s = s[1:]
			}
		}

	default:
		return 0, baseError(fnParseUint256, s0, base)
	}

	n, status, underscores := parseUint256Digits(s, base, base0)
	switch status {
	case digitsSyntax:
		return 0, syntaxError(fnParseUint256, s0)
	case digitsRange:
		return maxUint256, rangeError(fnParseUint256, s0)
	}

	if underscores && !underscoreOK(s0) {
		return 0, syntaxError(fnParseUint256, s0)
	}

	return n, nil
}

// ParseInt256 interprets a string s in the given base (0, 2 to 36) and
// returns the corresponding int256 value. It accepts what ParseInt accepts:
// an optional leading sign, and for base 0 a base prefix and underscores.
//
// The errors that ParseInt256 returns have concrete type *NumError and
// include err.Num = s. If s is empty or contains invalid digits, err.Err =
// ErrSyntax and the returned value is 0; if the value corresponding to s
// cannot be represented by an int256, err.Err = ErrRange and the returned
// value is the maximum magnitude int256 of the appropriate sign.
//
// As in ParseInt, the checks run in this order: each digit is checked, left
// to right, for syntax and for overflowing a uint256, and the first failure
// is returned at once (so a prefix that already overflows gives ErrRange even
// if an invalid character follows); then underscores are validated (base 0
// only); then the signed range is checked.
func ParseInt256(s string, base int) (i int256, err error) {
	const fnParseInt256 = "ParseInt256"

	if s == "" {
		return 0, syntaxError(fnParseInt256, s)
	}

	// Pick off leading sign.
	s0 := s
	neg := false
	if s[0] == '+' {
		s = s[1:]
	} else if s[0] == '-' {
		neg = true
		s = s[1:]
	}

	// Convert unsigned and check range.
	var un uint256
	un, err = ParseUint256(s, base)
	if err != nil && err.(*NumError).Err != ErrRange {
		err.(*NumError).Func = fnParseInt256
		err.(*NumError).Num = cloneString(s0)
		return 0, err
	}

	if !neg && un >= signBit256 {
		return maxInt256, rangeError(fnParseInt256, s0)
	}
	if neg && un > signBit256 {
		return minInt256, rangeError(fnParseInt256, s0)
	}
	n := int256(un)
	if neg {
		n = -n
	}
	return n, nil
}

// Status values of parseUint256Digits. Keep in sync with int256.go.
const (
	digitsOK     = 0
	digitsSyntax = 1
	digitsRange  = 2
)

// parseUint256Digits is the digit loop of ParseUint256, run natively (see
// int256.go). It reads s in base 2 to 36 left to right and stops at the first
// digit that is invalid (digitsSyntax) or makes the value overflow a uint256
// (digitsRange), checked in that order for each digit. With skipUnderscores,
// '_' is skipped and reported in underscores. On failure n is 0.
func parseUint256Digits(s string, base int, skipUnderscores bool) (n uint256, status int, underscores bool) // injected
