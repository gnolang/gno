package multisig

import "errors"

// Sentinel errors. Callers match on the value; messages stay stable.
var (
	ErrNotSigner           = errors.New("multisig: caller is not a signer")
	ErrUnauthorized        = errors.New("multisig: unauthorized")
	ErrStaleRealm          = errors.New("multisig: realm is not current")
	ErrInvalidAddress      = errors.New("multisig: invalid address")
	ErrDuplicateSigner     = errors.New("multisig: duplicate signer")
	ErrSignerCount         = errors.New("multisig: signer count out of range")
	ErrThreshold           = errors.New("multisig: threshold out of range")
	ErrDelay               = errors.New("multisig: delay out of range")
	ErrName                = errors.New("multisig: invalid name")
	ErrMemo                = errors.New("multisig: invalid memo")
	ErrExpiry              = errors.New("multisig: expiry out of range")
	ErrUnknownSafe         = errors.New("multisig: unknown safe")
	ErrUnknownProposal     = errors.New("multisig: unknown proposal")
	ErrNotPending          = errors.New("multisig: proposal is not pending")
	ErrExpired             = errors.New("multisig: proposal expired")
	ErrDuplicateApproval   = errors.New("multisig: duplicate approval")
	ErrNotApproved         = errors.New("multisig: approval not found")
	ErrNotReady            = errors.New("multisig: threshold not met")
	ErrTimelock            = errors.New("multisig: timelock has not elapsed")
	ErrArmed               = errors.New("multisig: proposal is armed")
	ErrPaused              = errors.New("multisig: safe is paused")
	ErrNotPaused           = errors.New("multisig: safe is not paused")
	ErrAlreadyPaused       = errors.New("multisig: safe is already paused")
	ErrInsufficientBalance = errors.New("multisig: insufficient balance")
	ErrAmount              = errors.New("multisig: invalid amount")
	ErrDenom               = errors.New("multisig: invalid denom")
	ErrToken               = errors.New("multisig: invalid token")
	ErrTarget              = errors.New("multisig: invalid call target")
	ErrPayload             = errors.New("multisig: invalid payload")
	ErrLastSigner          = errors.New("multisig: cannot remove the last signer")
	ErrUnknownSigner       = errors.New("multisig: signer not found")
	ErrTooManyPending      = errors.New("multisig: too many pending proposals")
	ErrHistory             = errors.New("multisig: proposal history is full")
	ErrTooManySafes        = errors.New("multisig: too many safes")
	ErrNotConsumable       = errors.New("multisig: call authorization is not consumable")
	ErrConsumed            = errors.New("multisig: call authorization already consumed")
	ErrBound               = errors.New("multisig: safe is already bound")
	ErrUnbound             = errors.New("multisig: safe is not bound")
	ErrSelf                = errors.New("multisig: address is the factory or the safe")
	ErrWatch               = errors.New("multisig: watch list rejected")
	ErrDeposit             = errors.New("multisig: deposit must be a direct user call")
	ErrKind                = errors.New("multisig: unsupported proposal")
	ErrHost                = errors.New("multisig: invalid host realm")
)
