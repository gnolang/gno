// Test vectors for drand evmnet.
//
// beaconVectors are real beacons fetched from
// https://api.drand.sh/04f1e9062b8a81f848fded9c12306733282b2727ecced50032187751166ec8c3/public/<round>
// and verified with drand/kyber. hashVectors are hash-to-G1 outputs computed by
// drand/kyber with the evmnet DST. The Go reference that produced them lives in
// contribs/gnodrand/internal/evmnet.

package drand

type beaconVector struct {
	round      uint64
	sig        string
	randomness string
}
type hashVector struct {
	msg   string
	point string
}

