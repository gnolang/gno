package main

func main() {
	println(caught())
	println(swallowed())
	println(fromCallee())
}

func caught() (n int) {
	defer func() {
		if recover() != nil {
			n = 7
		}
	}()
	panic("boom")
}

func swallowed() int {
	defer func() { recover() }()
	panic("boom")
}

func fromCallee() (n int) {
	defer func() {
		if recover() != nil {
			n = 5
		}
	}()
	return inner()
}

func inner() int { panic("inner") }
