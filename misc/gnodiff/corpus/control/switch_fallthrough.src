package main

func main() {
	println(kind(0))
	println(kind("a"))
	println(kind(1.5))
	println(fall(1))
	println(fall(2))
	println(fall(3))
	println(fall(9))
}

func kind(v interface{}) int {
	switch v.(type) {
	case nil:
		return 0
	case int:
		return 1
	case string:
		return 2
	default:
		return 3
	}
}

func fall(n int) int {
	x := 0
	switch n {
	case 1:
		x += 1
		fallthrough
	case 2:
		x += 10
	case 3:
		x += 100
	default:
		x += 1000
	}
	return x
}
