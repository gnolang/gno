package main

func main() {

	xs := []int{10, 20, 30}
	fs := make([]func() int, 0)
	for _, v := range xs {
		fs = append(fs, func() int { return v })
	}
	println(fs[0](), fs[1](), fs[2]())
	gs := make([]func() int, 0)
	for i := range xs {
		gs = append(gs, func() int { return i })
	}
	println(gs[0](), gs[1](), gs[2]())
}
