package main

type tally struct{ N int }

func (t tally) V() int { return t.N }

func main() {
	var i interface{} = tally{3}
	v, ok := i.(tally)
	println(ok, v.V())
	_, ok = i.(*tally)
	println(ok)
	var p *tally
	var j interface{} = p
	println(p == nil, j == nil)
	var k interface{}
	println(k == nil)
	_, ok = k.(tally)
	println(ok)
	switch i.(type) {
	case tally:
		println(1)
	case *tally:
		println(2)
	default:
		println(3)
	}
	switch k.(type) {
	case nil:
		println(0)
	default:
		println(9)
	}
}
