// A typed constant subtraction that does not fit in uint64.
// gc and gno lint reject it. gno run wraps, which is the runtime rule.
// gnodiff:known run accepts what lint rejects: constant overflow
// gnodiff:expect-go reject: overflows uint64
// gnodiff:expect-gno 18446744073709551584
package main

func main() {
	println(uint64(8) - uint64(40))
}
