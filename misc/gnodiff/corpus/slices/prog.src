// Nil slices, append, shared backing arrays, and copy.
package main

func main() {
	var s []int
	println(len(s), cap(s), s == nil)
	s = append(s, 1, 2, 3)
	println(len(s), s[0], s[2])
	t := s[:2]
	t[0] = 9
	println(s[0], len(t))
	u := append([]int{}, s...)
	u[0] = 1
	println(s[0], u[0], u[2])
	dst := []int{0, 0, 0}
	n := copy(dst, s[1:])
	println(n, dst[0], dst[1], dst[2])
	empty := s[1:1]
	println(empty == nil, len(empty))
}
