package main

func main() {

	m := map[string]int{"a": 1, "b": 2, "c": 3}
	sum := 0
	keys := 0
	for k, v := range m {
		sum += v
		if k != "" {
			keys++
		}
	}
	println(sum, keys, len(m))
	println(m["a"], m["missing"])
	delete(m, "b")
	delete(m, "missing")
	_, ok := m["b"]
	println(len(m), ok, m["c"])
}
