# A real dependency chain, twenty-six packages deep, where each link genuinely
# cannot be verified until the one before it has COMMITTED.
#
# That is not contrived, it falls out of two facts. hybridGetter routes every
# gno.IsUserlib path to RPC and refuses disk when a remote is set
# (getter.go:39-49), and vm/qfile cannot see a parked package
# (keeper_inert.go:513-516). So a dependency that is submitted but not yet
# enabled is invisible to the verifier: the package that imports it fails to
# resolve the import and is REJECTED, permanently, by content hash.
#
# The closure is gno.land/r/gnoland/boards2/v1 -- 23 pure packages plus
# r/gov/dao, r/sys/users and boards2 itself, roughly 464KB transitive. The
# order below is a topological sort of the imports actually declared in those
# files. Note that r/sys/users names r/sys/users/init in a string constant
# rather than importing it (admin.gno:13), which reads as a cycle to anything
# scanning whole files; there is none, and r/sys/users/init is not in the
# closure at all.
#
# The scenario submits all twenty-six and then waits on the LAST one. That is
# the whole proof: gpao drains one queue on one verifier goroutine
# (oracle.go:405) and its enable blocks until the transaction commits
# (BroadcastTxCommit), so by the time it reaches a package, everything queued
# before it is live. boards2 rendering is therefore not one assertion among
# twenty-six -- it is unreachable unless every dependency was verified,
# approved, broadcast and committed, in order.
#
# -gas-wanted is 500000000 here rather than the 20000000 the smaller scenarios
# use. These are real packages: boards2 alone is 113KB, and the sim lane
# already deploys it at this value (internal/sim/executor.go:88).
#
# Its own suite: twenty-six live packages is a lot of state to leave in a
# shared cluster, and the reverse-order arm this does NOT yet cover would need
# a chain where none of them exist.

gpao start -start-height 1

gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/bptree/v0 -pkgpath gno.land/p/nt/bptree/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/cford32/v0 -pkgpath gno.land/p/nt/cford32/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/seqid/v0 -pkgpath gno.land/p/nt/seqid/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/ufmt/v0 -pkgpath gno.land/p/nt/ufmt/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/gnoland/boards -pkgpath gno.land/p/gnoland/boards $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/gnoland/boards/exts/hub -pkgpath gno.land/p/gnoland/boards/exts/hub $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/avl/v0 -pkgpath gno.land/p/nt/avl/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/addrset -pkgpath gno.land/p/moul/addrset $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/groups/v0 -pkgpath gno.land/p/nt/groups/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/gnoland/boards/exts/permissions -pkgpath gno.land/p/gnoland/boards/exts/permissions $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/jeronimoalbi/mdform -pkgpath gno.land/p/jeronimoalbi/mdform $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/jeronimoalbi/pager -pkgpath gno.land/p/jeronimoalbi/pager $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/demo/svg -pkgpath gno.land/p/demo/svg $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/leon/svgbtn -pkgpath gno.land/p/leon/svgbtn $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/markdown/sanitize/v0 -pkgpath gno.land/p/nt/markdown/sanitize/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/md -pkgpath gno.land/p/moul/md $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/mdtable -pkgpath gno.land/p/moul/mdtable $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/realmpath -pkgpath gno.land/p/moul/realmpath $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/txlink -pkgpath gno.land/p/moul/txlink $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/markdown/foreign/v0 -pkgpath gno.land/p/nt/markdown/foreign/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/mdalert/v0 -pkgpath gno.land/p/nt/mdalert/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/mux/v0 -pkgpath gno.land/p/nt/mux/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/bptree/v0/rotree -pkgpath gno.land/p/nt/bptree/v0/rotree $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/r/gov/dao -pkgpath gno.land/r/gov/dao $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/r/sys/users -pkgpath gno.land/r/sys/users $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/r/gnoland/boards2/v1 -pkgpath gno.land/r/gnoland/boards2/v1 $USER_NAME

# The head of the closure, live. Everything above it had to be verified,
# approved, broadcast and committed first, in order, or this could not resolve
# its imports at all.
eventually gnokey query vm/qrender -data 'gno.land/r/gnoland/boards2/v1:'
stdout 'board'

# The oracle's own verdict on the head, not just the chain's.
http_get $GPAO_STATUS/status/gno.land/r/gnoland/boards2/v1
stdout '"status":"approved"'

# Nothing left behind: the queue drained rather than stalling partway. Polled
# to empty with a deadline, because the run ending is not the queue emptying.
gnokey query vm/qinertpaths -data ''
! stdout 'gno.land/'

gpao stop
-- cluster --
validators: 1
code-submission-policy: inert
