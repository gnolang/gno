# Twenty-six packages deep, each link genuinely unverifiable until the one
# before it has committed, and every one of them approved.
#
# That constraint is not contrived. hybridGetter routes every gno.IsUserlib path
# to RPC and refuses disk when a remote is set, and vm/qfile cannot see a parked
# package, so a dependency submitted but not yet enabled is invisible to the
# verifier: the package importing it fails to resolve the import. Submitting in
# dependency order is what keeps every import resolvable at the moment it is
# checked.
#
# The closure is gno.land/r/gnoland/boards2/v0: 23 pure packages plus r/gov/dao,
# r/sys/users and boards2 itself, roughly 464KB transitive. The order below is a
# topological sort of the imports those files declare. r/sys/users names
# r/sys/users/init in a string constant rather than importing it, which reads as
# a cycle to anything scanning whole files; there is none, and r/sys/users/init
# is not in the closure.
#
# Waiting on the LAST package is the whole proof. gpao drains one queue on one
# verifier goroutine and its enable blocks until the transaction commits, so by
# the time it reaches a package everything queued before it is live. boards2
# rendering is unreachable unless all twenty-five dependencies were verified,
# approved, broadcast and committed, in order.
#
# -gas-wanted is 500000000 rather than the 20000000 the smaller scenarios use.
# These are real packages, and boards2 alone is 113KB.

# ---- The closure, submitted in dependency order
gpao start -start-height 1

gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/bptree/v0 -pkgpath gno.land/p/nt/bptree/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/cford32/v0 -pkgpath gno.land/p/nt/cford32/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/seqid/v0 -pkgpath gno.land/p/nt/seqid/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/ufmt/v0 -pkgpath gno.land/p/nt/ufmt/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/gnoland/boards/v0 -pkgpath gno.land/p/gnoland/boards/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/gnoland/boards/exts/hub/v0 -pkgpath gno.land/p/gnoland/boards/exts/hub/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/avl/v0 -pkgpath gno.land/p/nt/avl/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/addrset/v0 -pkgpath gno.land/p/moul/addrset/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/groups/v0 -pkgpath gno.land/p/nt/groups/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/gnoland/boards/exts/permissions/v0 -pkgpath gno.land/p/gnoland/boards/exts/permissions/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/jeronimoalbi/mdform/v0 -pkgpath gno.land/p/jeronimoalbi/mdform/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/jeronimoalbi/pager/v0 -pkgpath gno.land/p/jeronimoalbi/pager/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/svg/v0 -pkgpath gno.land/p/nt/svg/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/leon/svgbtn/v0 -pkgpath gno.land/p/leon/svgbtn/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/markdown/sanitize/v0 -pkgpath gno.land/p/nt/markdown/sanitize/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/md/v0 -pkgpath gno.land/p/moul/md/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/mdtable/v0 -pkgpath gno.land/p/moul/mdtable/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/realmpath/v0 -pkgpath gno.land/p/moul/realmpath/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/moul/txlink/v0 -pkgpath gno.land/p/moul/txlink/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/markdown/foreign/v0 -pkgpath gno.land/p/nt/markdown/foreign/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/mdalert/v0 -pkgpath gno.land/p/nt/mdalert/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/mux/v0 -pkgpath gno.land/p/nt/mux/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/p/nt/bptree/rotree/v0 -pkgpath gno.land/p/nt/bptree/rotree/v0 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/r/gov/dao -pkgpath gno.land/r/gov/dao $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/r/sys/users -pkgpath gno.land/r/sys/users $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 500000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $GNOROOT/examples/gno.land/r/gnoland/boards2/v0 -pkgpath gno.land/r/gnoland/boards2/v0 $USER_NAME

# ---- The head of the closure is unreachable unless every link landed
# Live. Everything above it had to be verified,
# approved, broadcast and committed first, in order, or this could not resolve
# its imports at all. 90s, because that is 26 verifications and 26 enables, one
# at a time.
eventually 90s gnokey query vm/qrender -data 'gno.land/r/gnoland/boards2/v0:'
stdout 'board'

# The oracle's own verdict on the head, not just the chain's. Polled: the board
# records the approval after the broadcast returns, which can be after the
# render above first answers.
eventually http_get $GPAO_STATUS/status/gno.land/r/gnoland/boards2/v0 '"status":"approved"'

# Nothing left behind. A one-shot read: the head rendering above already proves
# the queue drained past every entry, since the head was submitted last.
gnokey query vm/qinertpaths -data ''
! stdout 'gno.land/'

-- cluster --
validators: 1
code-submission-policy: inert
