# The run budget is debited before an approval is attempted, not after it
# succeeds (oracle.go:531-533). The comment justifying that order says the
# ante handler charges a failed approval exactly as much as a successful one
# -- true for a message that reaches the chain, and precisely wrong for one
# that never does: enable() can return before ever calling BroadcastTxCommit
# (oracle.go:781-787,806), on a deterministic verdict from simulate. The
# debit already happened by then.
#
# init() panicking produces that deterministic verdict with nothing more
# exotic than a normal submission: gpao's verifier never executes it
# (verifier.go:121-131 calls PreprocessFiles, not RunMemPackage, because an
# unmetered init() could hang the daemon forever), so the package PASSES
# verification -- but EnablePackage's activation DOES run init()
# (keeper_inert.go:257-263), so the enable message fails at simulate, every
# time, deterministically.
#
# -max-spend is set to 3x the default -gas-fee (1000000ugnot). wouldExceedSpend
# is o.spent+o.enableFee > o.maxSpend (oracle.go:617), so three debits of
# 1000000 land exactly on the 3000000 bound, and a fourth candidate is
# refused before any further debit.
#
# boom1, boom2 and boom3 stay parked forever: nothing here, or in gpao
# itself, ever moves them out of "pending". That is inherent to what this
# scenario demonstrates, not an oversight.

gpao start -start-height 1 -max-spend 3000000ugnot

# Compared against itself at the end rather than against a literal, because
# what this proves is that nothing moved, and the figure it started from does
# not matter to that.
gnokey query bank/balances/$GPAO_ADDR
cp stdout balance-before.txt

gnokey maketx addpkg -broadcast=true -gas-wanted 20000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $WORK/boom1 -pkgpath gno.land/r/probe/boom1 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 20000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $WORK/boom2 -pkgpath gno.land/r/probe/boom2 $USER_NAME
gnokey maketx addpkg -broadcast=true -gas-wanted 20000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $WORK/boom3 -pkgpath gno.land/r/probe/boom3 $USER_NAME

# gpao drains one candidate queue on one verifier goroutine (oracle.go:405),
# so boom3 reaching a terminal verdict proves boom1 and boom2 -- queued
# strictly earlier -- have certainly already been decided too. Decided, not
# necessarily debited: the rejected (oracle.go:495), already-active (:506),
# verify-budget (:485) and blocked (:522) branches all reach a verdict without
# spending. What forces all three debits is the "blocked" assertion at the end
# of this file, in conjunction with this one; FIFO order alone does not.
#
# "pending" is a terminal verdict here because recordEnableFailure leaves the
# content unseen until maxEnableAttempts (oracle.go:600-608), so nothing here
# ever resolves it further. "blocked" has no chain-state equivalent to poll --
# nothing happens on chain at all for either verdict -- so this uses the
# body-gated http_get form rather than a chain read.
eventually http_get $GPAO_STATUS/status/gno.land/r/probe/boom3 '"status":"pending"'

# WHICH "pending", pinned directly rather than left to the conjunction above:
# statusPending is also written when the verifier is unavailable
# (oracle.go:462) and when verification runs out of time (:485), and neither
# of those debits. Only the enable-failure branch (:549) records the error
# enable() returned, and for a package whose init() panics that error is
# simulate's (oracle.go:787). One-shot: the gated wait above already proved
# the record settled, and http_get succeeds on any HTTP 200 regardless of
# body, so retrying this would poll nothing.
http_get $GPAO_STATUS/status/gno.land/r/probe/boom3
stdout '"reason":"simulate says the enable would fail'

# Half the proof: the balance did not move, so no transaction for any of the
# three ever reached BroadcastTxCommit, the ante handler never ran, and no fee
# was ever actually paid. That the counter moved three times regardless is
# what the "blocked" assertion below establishes -- cmp cannot see the
# counter.
gnokey query bank/balances/$GPAO_ADDR
cp stdout balance-after.txt
cmp balance-before.txt balance-after.txt

# The counter moved, though: a fourth, well-formed candidate lands with
# spent already at 3000000 -- +enableFee is 4000000, past the bound -- so
# wouldExceedSpend refuses it before any enable is attempted and before any
# further debit. Nothing is wrong with this package; only the budget is.
gnokey maketx addpkg -broadcast=true -gas-wanted 20000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $WORK/overbudget -pkgpath gno.land/r/probe/overbudget $USER_NAME
eventually http_get $GPAO_STATUS/status/gno.land/r/probe/overbudget '"status":"blocked"'

gpao stop

-- cluster --
validators: 3
code-submission-policy: inert
-- boom1/gnomod.toml --
module = "gno.land/r/probe/boom1"
gno = "0.9"

-- boom1/boom1.gno --
package boom1

func init() {
	panic("boom1")
}

-- boom2/gnomod.toml --
module = "gno.land/r/probe/boom2"
gno = "0.9"

-- boom2/boom2.gno --
package boom2

func init() {
	panic("boom2")
}

-- boom3/gnomod.toml --
module = "gno.land/r/probe/boom3"
gno = "0.9"

-- boom3/boom3.gno --
package boom3

func init() {
	panic("boom3")
}

-- overbudget/gnomod.toml --
module = "gno.land/r/probe/overbudget"
gno = "0.9"

-- overbudget/overbudget.gno --
package overbudget

func Render(path string) string {
	return "never approved"
}
