# What the oracle is actually for. The chain re-runs typecheck and preprocess
# at activation anyway, so checking correctness off-chain proves nothing the
# chain would not catch. What only an off-chain actor can judge is wall-clock
# cost: how long a package takes to verify is not a consensus quantity, and
# there is nowhere on-chain to put it. -verify-budget is that judgement, and
# this is the only place its behaviour is exercised.
#
# The budget is 1ms deliberately, not a realistic value. It wraps the WHOLE
# child, including spawn and store construction -- verifyone.go:170 puts the
# timeout on runCtx -- and real children measure 0.15s to 0.66s. At 1ms the
# deadline fires before the child has finished spawning, so every property
# below holds because of what the code does rather than how fast this machine
# happens to be. validate() only requires a positive duration (main.go:157).
#
# Its own suite because the setting is hostile to everything sharing a cluster,
# and because what it leaves behind is the point: a package the oracle refused
# to spend time on stays parked, and a suite that ran after this one would
# inherit it.

gpao start -start-height 1 -verify-budget 1ms

gnokey query bank/balances/$GPAO_ADDR
cp stdout balance-before.txt

gnokey maketx addpkg -broadcast=true -gas-wanted 20000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $WORK/slow -pkgpath gno.land/r/slow/one $USER_NAME

# PENDING, not rejected. The distinction is the whole design: running out of
# time is a statement about the oracle's budget, not about the submitter's
# code, so the package is left unseen and stays eligible (oracle.go:466-487).
# Calling it rejected would condemn a good package for the operator's
# configuration.
eventually http_get $GPAO_STATUS/status/gno.land/r/slow/one '"status":"pending"'
stdout '"reason":"verification ran out of time; will be retried"'
stdout '"attempt":1'

# Nothing reached the chain: not live, and still listed as awaiting approval.
! gnokey query vm/qfile -data gno.land/r/slow/one
gnokey query vm/qinertpaths -data ''
stdout 'gno.land/r/slow/one'

# Three ENCOUNTERS reach the give-up bound (maxOverBudgetAttempts, oracle.go:117),
# and they have to be resubmissions rather than restarts. o.overBudget is a
# per-process map (oracle.go:183), so a restart resets the count to zero and
# could never accumulate one. Leaving the key unseen is exactly what makes a
# resubmission of identical bytes effective instead of a no-op.
#
# The same bytes each time, so the candidate key -- path plus content hash --
# is the same one whose count is being raised.
gnokey maketx addpkg -broadcast=true -gas-wanted 20000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $WORK/slow -pkgpath gno.land/r/slow/one $USER_NAME
eventually http_get $GPAO_STATUS/status/gno.land/r/slow/one '"attempt":2'

gnokey maketx addpkg -broadcast=true -gas-wanted 20000000 -gas-fee 1000000ugnot -chainid $CHAIN_ID -pkgdir $WORK/slow -pkgpath gno.land/r/slow/one $USER_NAME

# Given up on, and the reason names the fix. This is the one verdict that
# tells an operator to change their own configuration rather than tell the
# submitter to change their code.
eventually http_get $GPAO_STATUS/status/gno.land/r/slow/one '"status":"gave_up"'
stdout 'needs a larger -verify-budget'
stdout '"attempt":3'

# And it cost nothing. An overrun returns before enable is ever attempted, so
# no message reached the chain and the ante handler never ran -- across three
# encounters and a give-up. Compared against itself rather than a literal,
# because what this proves is that the figure did not move.
gnokey query bank/balances/$GPAO_ADDR
cp stdout balance-after.txt
cmp balance-before.txt balance-after.txt

# CONTROL ARM. The same bytes, a budget that fits, and they go live -- so
# nothing above was a judgement about the package. A restart is what re-offers
# it: the give-up marked the key seen, and seen is per-process too, so the new
# run reconsiders it from the rescan.
gpao stop
gpao start -start-height 1

eventually gnokey query vm/qrender -data 'gno.land/r/slow/one:x'
stdout 'slow'

# And the queue is empty: what the budget refused to spend time on, a working
# budget finished.
gnokey query vm/qinertpaths -data ''
! stdout 'gno.land/r/slow/one'

gpao stop

-- cluster --
validators: 1
code-submission-policy: inert
-- slow/gnomod.toml --
module = "gno.land/r/slow/one"
gno = "0.9"

-- slow/slow.gno --
package one

func Render(path string) string {
	return "slow"
}
